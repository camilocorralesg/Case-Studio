---
/* The one page. The order matters: a part can override the styles of the ones before it, and color and menu wrap a function ensamble defines */
import Base from '../layouts/Base.astro';
import Logo from '../partes/logo.astro';
import Comun from '../partes/comun.astro';
import Encuadre from '../partes/encuadre.astro';
import Hero from '../partes/hero.astro';
import Escenas from '../partes/escenas.astro';
import Servicios from '../partes/servicios.astro';
import Formula from '../partes/formula.astro';
import Rediseno from '../partes/rediseno.astro';
import Visor from '../partes/visor.astro';
import Proyectos from '../partes/proyectos.astro';
import Marcas from '../partes/marcas.astro';
import Proceso from '../partes/proceso.astro';
import Redes from '../partes/redes.astro';
import Preguntas from '../partes/preguntas.astro';
import Cierre from '../partes/cierre.astro';
import Contacto from '../partes/contacto.astro';
import Ensamble from '../partes/ensamble.astro';
import Pie from '../partes/pie.astro';
import Uniones from '../partes/uniones.astro';
import Color from '../partes/color.astro';
import Menu from '../partes/menu.astro';
import Idioma from '../i18n/idioma.astro';
import Arranque from '../partes/arranque.astro';
---
<Base>
  <Logo />
  <Comun />
  <Encuadre />
  <Hero />
  <Escenas />
  <Servicios />
  <Formula />
  <Rediseno />
  <Visor />
  <Proyectos />
  <Marcas />
  <Proceso />
  <Redes />
  <Preguntas />
  <Cierre />
  <Contacto />
  <Ensamble />
  <Pie />
  <Uniones />
  <Color />
  <Menu />
  <Idioma />
  <Arranque />
</Base>
