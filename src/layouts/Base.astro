---
/* The page shell: head, fonts, colour tokens, base styles and the shared runtime every part uses */
---
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>CaSe Studio | Sitios web, tiendas en línea, redes y marca</title>
<meta name="description" content="CaSe Studio es un estudio de Medellín: sitios web, tiendas en línea, redes sociales y marca, hechos por el mismo equipo.">
<meta property="og:type" content="website">
<meta property="og:site_name" content="CaSe Studio">
<meta property="og:locale" content="es_CO">
<meta property="og:title" content="CaSe Studio | Sitios web, tiendas en línea, redes y marca">
<meta property="og:description" content="CaSe Studio es un estudio de Medellín: sitios web, tiendas en línea, redes sociales y marca, hechos por el mismo equipo.">
<meta name="twitter:card" content="summary">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Schibsted+Grotesk:wght@400..800&display=swap" rel="stylesheet">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 208 100'%3E%3Crect width='100' height='100' rx='12' fill='%23171717'/%3E%3Crect x='108' width='100' height='100' rx='12' fill='%23171717'/%3E%3Crect x='122' y='14' width='72' height='72' rx='5' fill='%23fff'/%3E%3C/svg%3E">
<style is:global>
:root{
  /* CaSe Studio: white, black and blue. Full-bleed pages with thin gutters */
  --paper:#fafafa; --surface:#ffffff; --mist:#f4f4f5; --line:#d4d4d4;
  --ink:#171717; --ink-2:#4a4a4a;
  /* the blues of the table (16 November 2026): one cobalt, and every other blue with a job of its own */
  --night:#02040a;          /* the ground at night */
  --cell:#0a1638;           /* an element at rest */
  --deep:#0a1f5c;           /* navy: the ink on the lab paper */
  --cobalt:#1e55e0;         /* the cobalt: what is chosen, bonded or done; the illustrations are taken to it (herramientas/cobalto.py) */
  --cobalt-deep:#1541b8;    /* the body of a lit element, under its light */
  --sky:#3d8bff;            /* small marks of light, like the square of "Disponibles" */
  --ice:#cfe0ff;            /* what shines on the night: text and edges */
  --frost:#8fb0ff;          /* numbers and quiet words on the night */
  --lab:#f4f7ff;            /* the lab paper of Servicios, Fórmula and Proceso */
  --focus:#6ea0ff;          /* the focus ring on the night; on paper the ring is the cobalt */
  /* an element lit from inside, as the hero draws them: its light sits high and soft, so its white symbol and number read */
  --lit:radial-gradient(70% 70% at 50% 30%,rgba(130,186,255,.44),rgba(48,118,255,.27) 48%,rgba(var(--cobalt-rgb),0) 100%),linear-gradient(180deg,rgba(160,196,255,.12),rgba(0,4,16,.28)),var(--cobalt-deep);
  --you-face:radial-gradient(70% 60% at 30% 20%,rgba(var(--sky-rgb),.55),rgba(var(--sky-rgb),0) 72%),linear-gradient(#0d2a80,#071546);   /* the face of Tú, your brand's element: in the closing and in the formula */
  /* their channels, for what is seen through: rgba(var(--cobalt-rgb),.2). The glow is the hero's light, brighter than the cobalt;
     the edge is the line of an element at rest */
  --night-rgb:2,4,10; --deep-rgb:10,31,92; --cobalt-rgb:30,85,224; --glow-rgb:30,107,255; --sky-rgb:61,139,255; --edge-rgb:118,166,255; --ice-rgb:207,224,255;
  --font:"Schibsted Grotesk", ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
  --mono:"IBM Plex Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
  --gutter:clamp(16px, 2.4vw, 40px);
  /* one way of moving (16 November 2026): every duration of the page is one of these seven, and every curve one of the two */
  --d-press:90ms;           /* a press */
  --d-hover:150ms;          /* a hover: a small answer to the hand */
  --d-fade:200ms;           /* what appears, hides or changes colour */
  --d-state:260ms;          /* a state that changes: a row that lights, the menu that comes in */
  --d-move:440ms;           /* something that moves into its place */
  --d-enter:560ms;          /* an entrance */
  --d-scene:720ms;          /* a long arrival: the headline of the hero, a card that lands */
  --ease-out:cubic-bezier(.23,1,.32,1);    /* what arrives: fast, then it settles */
  --ease-io:cubic-bezier(.77,0,.175,1);    /* what goes from one state to another and back: a row that unfolds, the detail widening */
  --r-card:14px; --r-media:20px;
  --t-display:calc(clamp(44px, 6.4vw, 96px) * var(--hs, 1));
  --t-h2:calc(clamp(32px, 3.6vw, 56px) * var(--hs, 1));
  /* type: Schibsted Grotesk for headlines, element symbols and text; IBM Plex Mono for atomic numbers and data */
  --body:var(--font);
  --head:"Schibsted Grotesk", ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
  --sym:"Schibsted Grotesk", ui-sans-serif, system-ui, sans-serif;
  --head-w:600; --head-ls:-.04em; --head-lh:1; --hs:1;
  --t-lead:clamp(17px, 1.32vw, 21px);
}
*{box-sizing:border-box}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%;color-scheme:light}
body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--font);font-size:17px;line-height:1.5;
  -webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility;caret-color:var(--cobalt);
  scrollbar-color:#c4c4c4 transparent;scrollbar-width:thin}
::selection{background:rgba(var(--glow-rgb),.2)}
:focus-visible{outline:2px solid var(--cobalt);outline-offset:2px;border-radius:6px}
/* a section or a title that receives the focus from a link is not a control: no ring around it */
[tabindex="-1"]:focus{outline:none}
img,svg,canvas{display:block;max-width:100%}
h1,h2,h3,p,ul,ol,figure{margin:0}
ul,ol{padding:0;list-style:none}
h1,h2,h3{text-wrap:balance;font-weight:500}
/* paragraphs don't leave a word alone on their last line */
p{text-wrap:pretty}
a{color:inherit}
button{font:inherit;color:inherit}
.wrap{padding-inline:var(--gutter)}
.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0}
.mono{font-family:var(--mono);font-size:13px;letter-spacing:0;font-variant-numeric:tabular-nums}
.display{font-family:var(--head);font-size:var(--t-display);line-height:var(--head-lh);letter-spacing:var(--head-ls);font-weight:var(--head-w)}
.h2{font-family:var(--head);font-size:var(--t-h2);line-height:calc(var(--head-lh) + .05);letter-spacing:calc(var(--head-ls) * .75);font-weight:var(--head-w)}
.lead{font-family:var(--body);font-size:var(--t-lead);line-height:1.45;color:var(--ink-2);max-width:34em}

/* logo (symbols live at the top of body) */
.logo{display:block;height:26px;width:auto;aspect-ratio:3.837;color:var(--ink);fill:currentColor;transition:color var(--d-fade) ease}
.logo--dark{color:#fff}

/* navigation: 64px, words draw a 1px line under them */
.nav{position:relative;z-index:5;height:64px;display:flex;align-items:center;justify-content:space-between;gap:24px;padding-inline:var(--gutter)}
.nav__home{display:flex;align-items:center;min-height:44px;text-decoration:none}
.nav__links{display:flex;gap:28px;font-size:15px}
.nav__links a{position:relative;color:var(--ink-2);text-decoration:none;padding-block:10px;transition:color var(--d-hover) ease}
.nav__links a::after{content:"";position:absolute;left:0;right:0;bottom:6px;height:1px;background:currentColor;transform:scaleX(0);transform-origin:right;transition:transform var(--d-hover) var(--ease-out)}
@media (hover:hover) and (pointer:fine){
  .nav__links a:hover{color:var(--ink)}
  .nav__links a:hover::after{transform:scaleX(1);transform-origin:left}
}
.nav--dark .nav__links a{color:#c9c9cc}
@media (hover:hover) and (pointer:fine){.nav--dark .nav__links a:hover{color:#fff}}
@media (max-width:860px){.nav__links{display:none}}
/* with the links on, three columns: the links sit in the true middle, whatever the logo and the end measure */
@media (min-width:861px){
  .nav{display:grid;grid-template-columns:1fr auto 1fr}
  .nav__home{justify-self:start}
  .nav__end{justify-self:end}
}

/* buttons: step 1px up on hover, sink and press on click */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:48px;padding:0 22px;border-radius:999px;
  border:1px solid transparent;font:500 15px/1 var(--font);letter-spacing:-.01em;text-decoration:none;cursor:pointer;white-space:nowrap;
  transition:transform var(--d-hover) var(--ease-out),background-color var(--d-hover) ease,border-color var(--d-hover) ease,color var(--d-hover) ease}
.btn--sm{min-height:44px;padding:0 18px;font-size:14px}
/* the main buttons are firm (600) and the ghost one is quieter, so the two of a pair never weigh the same */
.btn--ink{background:var(--ink);color:#fff;font-weight:600}
.btn--white{background:#fff;color:var(--ink);font-weight:600}
.btn--ghost-dark{background:transparent;color:rgba(255,255,255,.88);border-color:rgba(255,255,255,.28)}
.btn .arr{width:14px;height:14px;transition:transform var(--d-hover) var(--ease-out)}
@media (hover:hover) and (pointer:fine){
  .btn:hover{transform:translateY(-1px)}
  .btn:hover .arr{transform:translateX(3px)}
  .btn--ink:hover{background:#2e2e2e}
  .btn--white:hover{background:#ececec}
  .btn--ghost-dark:hover{background:rgba(255,255,255,.08);border-color:rgba(255,255,255,.5);color:#fff}
}
.btn:active{transform:translateY(1px) scale(.985);transition-duration:var(--d-press)}

/* hero entrance: lines rise out of masks, then the lead and actions, the picture settles; about 1.1 s, once */
.ln{display:block;overflow:hidden;padding-bottom:.12em;margin-bottom:-.12em}
.ln>span{display:inline-block}
.is-entering .ln>span{animation:lnUp var(--d-scene) var(--ease-out) both;animation-delay:calc(var(--i,0)*80ms)}
.is-entering .up{animation:fadeUp var(--d-enter) var(--ease-out) both;animation-delay:calc(260ms + var(--i,0)*60ms)}
@keyframes lnUp{from{transform:translateY(112%)}}
@keyframes fadeUp{from{opacity:0;transform:translateY(12px)}}
@keyframes settle{from{transform:scale(.98)}}

/* a scroll moment: a tall section whose stage stays on screen while the page scrolls natively */
.moment{position:relative;height:var(--mh,260vh)}
.moment__stick{position:sticky;top:0;height:100vh;height:100svh;overflow:hidden}

/* shared client-site mockups (fictional clients) */

/* contact: the anchor every main action scrolls to */
.contact{background:var(--mist);padding:clamp(72px,10vw,140px) 0}
.contact__in{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));grid-template-rows:auto auto 1fr;column-gap:20px;row-gap:22px}
.contact__in h2{grid-column:1/7}
.contact__in .lead{grid-column:1/6}
.contact__form{grid-column:7/13;grid-row:1/4;display:grid;gap:14px;align-content:start}
.field{display:grid;gap:6px}
.field label{font-size:14px;color:var(--ink-2)}
.field input{font:inherit;font-size:16px;color:var(--ink);background:#fff;border:1px solid var(--line);border-radius:12px;padding:13px 14px;
  transition:border-color var(--d-hover) ease,box-shadow var(--d-hover) ease}
.field input:focus{outline:none;border-color:var(--cobalt);box-shadow:0 0 0 3px rgba(var(--cobalt-rgb),.16)}
.contact__form .btn{justify-self:start}
.contact__ok{min-height:1.5em;font-size:15px}
@media (max-width:860px){
  .contact__in{grid-template-columns:1fr;grid-template-rows:none}
  .contact__in h2,.contact__in .lead,.contact__form{grid-column:1/-1;grid-row:auto}
}

@media (prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  .is-entering .ln>span,.is-entering .up{animation:none}
  .btn,.btn .arr,.nav__links a::after{transition-property:background-color,border-color,color,opacity}
}

</style>
<script is:inline>
/* shared runtime */
window.VARIANTS = [];
/* the motion tokens of :root (--d-*, --ease-*), for the animations made from code: one way of moving for CSS and scripts */
const MOTION = {
  d: (k) => parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--d-' + k)) || 0,
  ease: (k) => getComputedStyle(document.documentElement).getPropertyValue('--ease-' + k).trim() || 'ease'
};
/* one symbol and one number for each element of the site (16 November 2026), keyed by its Spanish symbol. What lives in the
   footer's table carries its number there: Ca and Se, the services, the sections (Redes is the service Redes sociales) and Contacto
   at cobalt's 27. The clients share one count, projects and then brands, so Weed Honey is one element in both. "Tu marca" is Tú,
   119, the element that does not exist yet. What lives in one list only (the steps of Proceso, the stories of Redes, the Fórmula in
   Preguntas) is numbered by its place there. Servicios and the Fórmula write the same numbers in their markup */
const EL_Z = {
  Ca: 20, Se: 34, 'Tú': 119,
  Sw: 21, Ti: 22, Rs: 23, Ma: 24, Co: 27,
  Sv: 37, Rd: 38, Py: 39, Mc: 40, Pc: 41, Pr: 42,
  Ld: 1, Nn: 2, Nb: 3, Ak: 4, Wh: 5, Mi: 6, Ag: 7, Lm: 8, Sp: 9, "O'": 10, Ea: 11,
  Cn: 1, Di: 2, Cs: 3, La: 4,
  Ec: 1, Fv: 2, Mg: 3, Ai: 4, Cm: 5, Pu: 6,
  Fm: 2
};
const zOf = (s) => (s in EL_Z ? String(EL_Z[s]).padStart(2, '0') : '');
const RM = matchMedia('(prefers-reduced-motion: reduce)').matches;
const FINE = matchMedia('(hover: hover) and (pointer: fine)').matches;
const clamp01 = (v) => Math.min(1, Math.max(0, v));
const range = (p, a, b) => clamp01((p - a) / (b - a));            /* 0..1 inside [a, b] */
const easeIO = (t) => t < .5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
const easeOut = (t) => 1 - Math.pow(1 - t, 3);
const lerp = (a, b, t) => a + (b - a) * t;
/* Scroll moment: progress 0..1 of a .moment section while its stage is pinned. Native scroll, one read a frame. */
function moment(section, update) {
  let raf = 0;
  const calc = () => {
    raf = 0;
    const r = section.getBoundingClientRect();
    const total = section.offsetHeight - window.innerHeight;
    update(total > 0 ? clamp01(-r.top / total) : 1);
  };
  const onScroll = () => { if (!raf) raf = requestAnimationFrame(calc); };
  addEventListener('scroll', onScroll, { passive: true });
  addEventListener('resize', onScroll);
  calc();
  return () => { removeEventListener('scroll', onScroll); removeEventListener('resize', onScroll); cancelAnimationFrame(raf); };
}
</script>
</head>
<body>
<slot />
</body>
</html>
