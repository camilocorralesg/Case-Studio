---
import Flecha from '../components/Flecha.astro';
/* the services with their one number in the whole site (EL_Z in Base.astro: their place in the footer's table) */
const SERV = [['Sw', '21', 'Sitios web'], ['Ti', '22', 'Tiendas en línea'], ['Rs', '23', 'Redes sociales'], ['Ma', '24', 'Marca']];
---
<style is:global>
/* The formula, right after the services, on the same lab paper: the visitor taps the elements or drags them to the middle,
   and they bond into a compound. What they choose goes with them to the contact form. It is the one section that is not a
   moment: it is there to add something if the visitor wants to, so the scroll goes past it like any page (user's call) */
.v-tab .fx{background-color:var(--lab);color:#0a1020}
.v-tab .fx-in{display:flex;flex-direction:column;gap:clamp(10px,2vh,22px);min-height:100vh;min-height:100svh;padding:clamp(76px,11vh,108px) var(--gutter) clamp(36px,6vh,64px)}
/* the hint under the title, as in Servicios */
.v-tab .fx-head{display:flex;flex-direction:column;align-items:flex-start;gap:12px}
.v-tab .fx-head .lead{max-width:24em;color:#4a5878}
.v-tab .fx-field{position:relative;flex:1;min-height:clamp(460px,60vh,660px)}
.v-tab .fx-zone{position:absolute;left:0;top:0;border-radius:26px;background:rgba(var(--sky-rgb),.07);box-shadow:inset 0 0 0 1.5px rgba(var(--cobalt-rgb),.2);transition:background-color var(--d-fade) ease,box-shadow var(--d-fade) ease}
.v-tab .fx-zone.hot{background:rgba(var(--sky-rgb),.13);box-shadow:inset 0 0 0 1.5px rgba(var(--cobalt-rgb),.45)}
.v-tab .fx-zone span{position:absolute;left:16px;top:-26px;font-size:13px;color:#5a6785}
/* the elements: navy at rest, brand blue once bonded; bonded ones share their inner corners */
.v-tab .fx-t{position:absolute;left:0;top:0;display:flex;flex-direction:column;justify-content:space-between;width:var(--ts);height:var(--ts);padding:calc(var(--ts) * .1) calc(var(--ts) * .11);border:0;border-radius:16px;background:var(--cell);color:#fff;font:inherit;text-align:left;
  box-shadow:inset 0 0 0 1.5px rgba(var(--edge-rgb),.55),0 24px 44px -24px rgba(var(--deep-rgb),.65);z-index:2;cursor:grab;touch-action:none;user-select:none;-webkit-user-select:none;will-change:transform;transition:border-radius var(--d-fade) var(--ease-out),background-color var(--d-fade) ease}
@media (hover:hover) and (pointer:fine){.v-tab .fx-t:hover{translate:0 -2px;box-shadow:inset 0 0 0 1.5px rgba(160,196,255,.85),0 30px 50px -26px rgba(var(--deep-rgb),.7)}}
.v-tab .fx-t:active{cursor:grabbing}
.v-tab .fx-t:focus-visible{outline:2px solid var(--cobalt);outline-offset:3px}
.v-tab .fx-t i{font:400 12px/1 var(--mono);font-style:normal;color:var(--frost)}
.v-tab .fx-t b{font:600 calc(var(--ts) * .4)/.84 var(--sym);letter-spacing:-.045em}
.v-tab .fx-t span{font-size:13px;line-height:1.15;color:#c7d5f5}
.v-tab .fx-t[aria-pressed="true"]{background:var(--cobalt);box-shadow:inset 0 0 0 1.5px rgba(var(--ice-rgb),.55),0 24px 44px -24px rgba(var(--deep-rgb),.65)}
.v-tab .fx-t[aria-pressed="true"] i{color:var(--ice)}
.v-tab .fx-t[aria-pressed="true"] span{color:#e8f0ff}
.v-tab .fx-t[data-join="first"]{border-radius:16px 4px 4px 16px}
.v-tab .fx-t[data-join="mid"]{border-radius:4px}
.v-tab .fx-t[data-join="last"]{border-radius:4px 16px 16px 4px}
/* what the formula says, and the way to the contact form */
.v-tab .fx-out{position:absolute;left:0;right:0;top:0;display:grid;justify-items:center;gap:10px;text-align:center;pointer-events:none}
.v-tab .fx-out .btn{pointer-events:auto;margin-top:6px}
.v-tab .fx-f{font:600 clamp(28px,3vw,46px)/1.05 var(--sym);letter-spacing:-.035em}
.v-tab .fx-f.empty{color:#5a6785;font-family:var(--head);font-size:clamp(20px,1.8vw,26px);letter-spacing:-.02em}
.v-tab .fx-names{max-width:31em;color:#4a5878;font-size:clamp(15px,1.15vw,17px)}
.v-tab .fx-ex{padding:5px 11px;border-radius:999px;background:rgba(var(--sky-rgb),.1);font-size:12px;color:var(--cobalt)}
@media (max-width:700px){
  .v-tab .fx-head .lead{font-size:15px}
  .v-tab .fx-t span,.v-tab .fx-t i{font-size:11px}
}
@media (prefers-reduced-motion:reduce){
  .v-tab .fx-t,.v-tab .fx-zone{transition:none}
}
</style>

<template id="tpl-fx">
<section class="fx" id="formula" aria-labelledby="fx-h">
  <div class="fx-in">
    <div class="fx-head">
      <h2 class="h2" id="fx-h">Arma tu fórmula.</h2>
      <p class="lead">Toca los elementos o arrástralos al centro.</p>
    </div>
    <div class="fx-field">
      <div class="fx-zone"><span class="mono">tu fórmula</span></div>
      {SERV.map(([s, z, name]) => <button class="fx-t" type="button" aria-pressed="false" data-s={s}><i aria-hidden="true">{z}</i><b aria-hidden="true">{s}</b><span>{name}</span></button>)}
      <div class="fx-out" aria-live="polite">
        <p class="fx-f"></p>
        <p class="fx-names"></p>
        <span class="fx-ex mono">Ejemplo</span>
        <a class="btn btn--ink" href="#contacto">Pedir esta fórmula <Flecha /></a>
      </div>
    </div>
  </div>
</section>
</template>

<script is:inline>
/* The formula. It opens with an example (Sitios web + Redes sociales), marked as one; the first touch makes it the visitor's: it
   adds or takes away on top of the example (the user's call, 16 November 2026), and "Pedir esta fórmula" asks for what is shown. What the visitor bonds lives in window.FORMULA (it survives the language switch) and is copied
   into the contact form, where the same four services are to tick: each element checks its own by symbol. window.FORMULA_SET
   keeps what this section checked, so a choice made in the form itself is never undone. */
addSection('tabla', 'tpl-fx', 1.2, (root) => {
  const sec = root.querySelector('.fx'), field = sec.querySelector('.fx-field'), zone = sec.querySelector('.fx-zone'), out = sec.querySelector('.fx-out');
  const fEl = sec.querySelector('.fx-f'), names = sec.querySelector('.fx-names'), ex = sec.querySelector('.fx-ex');
  const tiles = [...sec.querySelectorAll('.fx-t')].map((el, i) => ({ el, i, s: el.dataset.s, name: () => el.querySelector('span').textContent.trim(), x: 0, y: 0, vx: 0, vy: 0, hx: 0, hy: 0 }));
  const F = window.FORMULA = window.FORMULA || new Set(), SET = window.FORMULA_SET = window.FORMULA_SET || new Set();
  const say = (t) => (window.LANG && LANG.cur === 'en' && window.I18N && I18N.tr(t)) || t;
  let example = !F.size, bonded = example ? ['Sw', 'Rs'] : [...F], drag = null, ts = 120, W = 0, H = 0, Z = { x: 0, y: 0, w: 0, h: 0 }, raf = 0, last = 0;

  /* ---- into the contact form: its four services are these four elements ---- */
  const carry = (k) => {
    const form = document.querySelector('#contacto .contact__form'); if (!form) return;
    const on = F.has(k), i = form.querySelector(`[name=need][data-sym="${k}"]`); if (!i) return;
    if (on && !i.checked) { i.checked = true; SET.add(k); }
    else if (!on && i.checked && SET.has(k)) { i.checked = false; SET.delete(k); }
    else return;
    i.dispatchEvent(new Event('input', { bubbles: true }));
  };
  const commit = () => {
    if (example) return;
    const before = new Set(F); F.clear(); bonded.forEach((k) => F.add(k));
    /* only what changed: a service the visitor unticked by hand stays so while its element stays in the formula */
    [...before].filter((k) => !F.has(k)).concat(bonded.filter((k) => !before.has(k))).forEach(carry);
  };

  /* ---- the field ---- */
  const layout = () => {
    /* the spread layout needs about 780px of field for the four tiles around the middle; below that they sit in a row on top */
    W = field.clientWidth; H = field.clientHeight; const narrow = W < 820;
    ts = narrow ? Math.max(72, Math.min(84, (W - 48) / 4.4)) : Math.max(96, Math.min(146, W * .095));
    sec.style.setProperty('--ts', ts + 'px');
    const zw = 4 * ts + (narrow ? 20 : 40), zh = ts + (narrow ? 20 : 40);
    if (narrow) {
      const top = 20 + ts / 2;
      tiles.forEach((t, i) => { t.hx = W / 2 + (i - 1.5) * (ts + 10); t.hy = top; });
      Z = { x: W / 2, y: top + ts / 2 + 44 + zh / 2, w: Math.min(zw, W), h: zh };
    } else {
      const cy = Math.min(H * .34, 40 + ts * 1.6);
      Z = { x: W / 2, y: cy, w: zw, h: zh };
      const dx = zw / 2 + ts * 1.3;
      tiles.forEach((t, i) => { t.hx = W / 2 + (i % 2 ? dx : -dx); t.hy = cy + (i < 2 ? -ts * .62 : ts * .62); });
    }
    zone.style.width = Z.w + 'px'; zone.style.height = Z.h + 'px';
    zone.style.transform = `translate3d(${(Z.x - Z.w / 2).toFixed(1)}px,${(Z.y - Z.h / 2).toFixed(1)}px,0)`;
    out.style.top = (Z.y + Z.h / 2 + (narrow ? 22 : 34)) + 'px';
    tiles.forEach((t) => { if (!t.x && !t.y) { const [gx, gy] = target(t, 0); t.x = gx; t.y = gy; } });
  };
  const target = (t, now) => {
    if (drag && drag.t === t && drag.moved) return [drag.x, drag.y];
    const k = bonded.indexOf(t.s);
    if (k >= 0) return [Z.x + (k - (bonded.length - 1) / 2) * ts, Z.y];
    return [t.hx, t.hy + (RM ? 0 : Math.sin(now * .55 + t.i * 1.9) * 3)];
  };
  const render = () => {
    tiles.forEach((t) => {
      const k = bonded.indexOf(t.s), n = bonded.length;
      t.el.setAttribute('aria-pressed', k >= 0 && !example ? 'true' : 'false');
      if (k < 0 || n === 1) t.el.removeAttribute('data-join');
      else t.el.dataset.join = k === 0 ? 'first' : k === n - 1 ? 'last' : 'mid';
    });
    ex.hidden = !example;
    if (!bonded.length) { fEl.textContent = say('Toca un elemento para empezar.'); fEl.classList.add('empty'); names.textContent = ''; return; }
    fEl.classList.remove('empty'); fEl.textContent = bonded.join(' + ');
    names.textContent = bonded.length === 4 ? say('Todos los elementos de tu marca en internet.') : bonded.map((s) => tiles.find((t) => t.s === s).name()).join(' + ');
  };
  /* the first touch keeps the example and makes it the visitor's: what they touch is added to it or taken from it */
  const own = () => { if (example) example = false; };
  const toggle = (s) => { own(); const k = bonded.indexOf(s); if (k >= 0) bonded.splice(k, 1); else bonded.push(s); render(); commit(); };
  const inZone = (x, y) => Math.abs(x - Z.x) < Z.w / 2 + 24 && Math.abs(y - Z.y) < Z.h / 2 + 24;
  const offs = [];
  const on = (el, ev, fn) => { el.addEventListener(ev, fn); offs.push(() => el.removeEventListener(ev, fn)); };
  tiles.forEach((t) => {
    on(t.el, 'pointerdown', (e) => {
      if (e.button !== 0) return;
      t.skip = false;
      const r = field.getBoundingClientRect();
      drag = { t, id: e.pointerId, sx: e.clientX, sy: e.clientY, ox: e.clientX - r.left - t.x, oy: e.clientY - r.top - t.y, x: t.x, y: t.y, moved: false };
      t.el.setPointerCapture(e.pointerId);
    });
    on(t.el, 'pointermove', (e) => {
      if (!drag || drag.t !== t || e.pointerId !== drag.id) return;
      if (!drag.moved && Math.hypot(e.clientX - drag.sx, e.clientY - drag.sy) < 6) return;
      const r = field.getBoundingClientRect();
      drag.moved = true; drag.x = e.clientX - r.left - drag.ox; drag.y = e.clientY - r.top - drag.oy;
      zone.classList.toggle('hot', inZone(drag.x, drag.y)); t.el.style.zIndex = '5';
    });
    const finish = (e) => {
      if (!drag || drag.t !== t || e.pointerId !== drag.id) return;
      if (drag.moved) {
        own();
        const k = bonded.indexOf(t.s); if (k >= 0) bonded.splice(k, 1);
        if (inZone(drag.x, drag.y)) {
          /* the place in the compound follows where it was dropped */
          let at = bonded.length;
          for (let j = 0; j < bonded.length; j++) if (drag.x < Z.x + (j - bonded.length / 2) * ts) { at = j; break; }
          bonded.splice(at, 0, t.s);
        }
        t.skip = true; render(); commit();
      }
      zone.classList.remove('hot'); t.el.style.zIndex = ''; drag = null;
    };
    on(t.el, 'pointerup', finish); on(t.el, 'pointercancel', finish);
    on(t.el, 'click', () => { if (t.skip) { t.skip = false; return; } toggle(t.s); });
  });
  /* "Pedir esta fórmula" with the example still on: the visitor asks for the formula they see, so it becomes theirs and goes to Contacto */
  on(out.querySelector('a[href="#contacto"]'), 'click', () => { if (example) { example = false; render(); commit(); } });
  /* calm springs while the section is on screen; with reduced motion the tiles just sit where they belong. Off screen the loop
     sleeps (an observer wakes it), instead of asking for every frame of the visit */
  const step = (now) => {
    raf = requestAnimationFrame(step);
    const dt = Math.min(.033, (now - (last || now)) / 1000); last = now; const tt = now / 1000;
    tiles.forEach((t) => {
      const [gx, gy] = target(t, tt);
      if (RM || (drag && drag.t === t && drag.moved)) { t.x = gx; t.y = gy; t.vx = t.vy = 0; }
      else { const kk = 190, cc = 2 * Math.sqrt(kk) * .92; t.vx += ((gx - t.x) * kk - t.vx * cc) * dt; t.vy += ((gy - t.y) * kk - t.vy * cc) * dt; t.x += t.vx * dt; t.y += t.vy * dt; }
      t.el.style.transform = `translate3d(${(t.x - ts / 2).toFixed(1)}px,${(t.y - ts / 2).toFixed(1)}px,0)`;
    });
  };
  layout(); render();
  let awake = false;
  const io = new IntersectionObserver(([e]) => {
    if (e.isIntersecting && !awake) { awake = true; last = 0; raf = requestAnimationFrame(step); }
    else if (!e.isIntersecting && awake) { awake = false; cancelAnimationFrame(raf); raf = 0; }
  }, { rootMargin: '60px 0px' });
  io.observe(sec);
  addEventListener('resize', layout);
  /* the contact form is built after the sections start: carry what was already chosen once it exists */
  SET.clear();
  const later = requestAnimationFrame(() => F.forEach(carry));
  return () => { io.disconnect(); cancelAnimationFrame(raf); cancelAnimationFrame(later); removeEventListener('resize', layout); offs.forEach((f) => f()); };
});
</script>
