---
import Nav from '../components/Nav.astro';
import Flecha from '../components/Flecha.astro';
import Pausa from '../components/Pausa.astro';
---
<style is:global>
/* Hero: the whole periodic table as a floor of tiles drawn like the logo's. Calcium and selenium float over their squares;
   at rest an element lights up here and there, and the scroll lifts the camera, lets the table fall away and brings Ca and Se
   together as the mark. */
.v-tab{background:var(--night);color:#fff}
.v-tab ::selection{background:rgba(var(--sky-rgb),.45)}
/* the hero is on the night: its ring is --focus */
.hx :focus-visible{outline-color:var(--focus)}
.v-tab .b-copy{position:absolute;z-index:2;left:0;right:0;top:64px;display:grid;justify-items:center;gap:22px;padding:clamp(20px,6vh,64px) var(--gutter) 0;text-align:center}
.v-tab .b-h1{font-size:calc(clamp(40px,5.6vw,84px) * var(--hs,1))}
.v-tab .b-copy .lead{margin-inline:auto;max-width:30em;color:#b3bfd3}
.v-tab .b-copy .acts{justify-content:center}
/* the first stop of the keyboard: past the bars, to the headline. Out of sight until it has the focus */
.skip{position:fixed;left:max(12px,env(safe-area-inset-left));top:12px;z-index:90;display:inline-flex;align-items:center;min-height:44px;padding:0 18px;border-radius:999px;background:#fff;color:var(--ink);font:600 14px/1 var(--font);text-decoration:none;transform:translateY(-160%);transition:transform var(--d-state) var(--ease-out)}
.skip:focus{transform:none}
/* on a phone the two buttons go one over the other, the same width, instead of two widths side by side */
@media (max-width:600px){
  .v-tab .b-copy .acts{flex-direction:column;align-items:stretch;width:min(100%,320px)}
  .v-tab .b-copy .acts .btn{width:100%}
}
.v-tab .hx__say{top:76%;color:#fff}
/* while the headline and its button are on screen, the bar does not repeat the button */
.v-tab .nav__cta{transition:opacity var(--d-state) var(--ease-out),transform var(--d-state) var(--ease-out),visibility 0s}
/* the language against the edge and the button before it, as in the fixed menu: while the button is away, its place is in the
   middle of the bar and not a hole at its edge */
.v-tab .nav__lang{order:2}
.v-tab .nav__cta.is-away{opacity:0;transform:translateY(-6px);visibility:hidden;pointer-events:none;transition:opacity var(--d-fade) ease,transform var(--d-fade) ease,visibility 0s linear var(--d-fade)}
</style>

<template id="tpl-tabla">
<div class="v v-tab" id="top">
  <a class="skip" href="#b-h1">Saltar al contenido</a>
  <section class="hx" aria-labelledby="b-h1" style="--hh:250vh">
    <div class="hx__stick">
      <canvas class="hx__vis vis-in" aria-hidden="true"></canvas>
      <Nav />
      <div class="hx__copy b-copy">
        <h1 class="display b-h1" id="b-h1" tabindex="-1">
          <span class="ln"><span style="--i:0">Todos los elementos</span></span>
          <span class="ln"><span style="--i:1">de tu marca en internet.</span></span>
        </h1>
        <p class="lead up" style="--i:0">Sitio web, tienda, redes y marca, hechos por el mismo equipo.</p>
        <div class="acts up" style="--i:1"><a class="btn btn--white" href="#contacto">Empezar mi proyecto <Flecha /></a><a class="btn btn--ghost-dark" href="#proyectos">Ver proyectos</a></div>
      </div>
      <p class="hx__say h2">Juntamos lo que tu marca necesita en un solo equipo.</p>
      <Pausa clase="hx__pause pause--dark" />
    </div>
  </section>
</div>
</template>

<script is:inline>
VARIANTS.push({
  id: 'tabla', name: 'Tabla', tpl: 'tpl-tabla',
  init(root) {
    const sec = root.querySelector('.hx'), stick = sec.querySelector('.hx__stick'), cv = stick.querySelector('canvas'), ctx = cv.getContext('2d');
    const copy = stick.querySelector('.hx__copy'), say = stick.querySelector('.hx__say');
    const SPR = markSprites();
    /* the symbols use the same face as the rest of the elements on the page (read again on resize: the type bar changes it) */
    const face = (v) => getComputedStyle(document.documentElement).getPropertyValue(v).trim() || 'sans-serif';
    let SYMF = face('--sym'), TEXTF = face('--font');
    const gap = (a, n, b) => [...a, ...Array(n).fill(''), ...b];
    const MAIN = [
      gap(['H'], 16, ['He']),
      gap(['Li', 'Be'], 10, ['B', 'C', 'N', 'O', 'F', 'Ne']),
      gap(['Na', 'Mg'], 10, ['Al', 'Si', 'P', 'S', 'Cl', 'Ar']),
      'K Ca Sc Ti V Cr Mn Fe Co Ni Cu Zn Ga Ge As Se Br Kr'.split(' '),
      'Rb Sr Y Zr Nb Mo Tc Ru Rh Pd Ag Cd In Sn Sb Te I Xe'.split(' '),
      'Cs Ba La Hf Ta W Re Os Ir Pt Au Hg Tl Pb Bi Po At Rn'.split(' '),
      'Fr Ra Ac Rf Db Sg Bh Hs Mt Ds Rg Cn Nh Fl Mc Lv Ts Og'.split(' ')
    ];
    const FBLOCK = ['Ce Pr Nd Pm Sm Eu Gd Tb Dy Ho Er Tm Yb Lu'.split(' '), 'Th Pa U Np Pu Am Cm Bk Cf Es Fm Md No Lr'.split(' ')];
    const G = 1.08, R0 = 3.6;
    /* each block of the table gets its own blue: no violet, the f block is a cooler steel blue */
    const TINT = { s: '118,166,255', d: '88,136,255', p: '120,196,255', f: '150,182,236' };
    const cells = [];
    let z = 0;
    MAIN.forEach((row, r) => row.forEach((s, c) => {
      if (!s) return;
      z++; if (s === 'Hf') z = 72; if (s === 'Rf') z = 104;
      cells.push({ s, z, c, r, x: (c - 8.5) * G, v: (r - R0) * G, tint: TINT[c < 2 ? 's' : c < 12 ? 'd' : 'p'] });
    }));
    FBLOCK.forEach((row, k) => row.forEach((s, i) => cells.push({ s, z: (k ? 90 : 58) + i, c: i + 3, r: 7 + k, x: (i + 3 - 8.5) * G, v: (7 + k - R0 + .45) * G, tint: TINT.f })));
    /* the name of every element, by atomic number, in the language the page is in */
    const NAMES = (window.LANG && window.LANG.cur === 'en'
      ? 'Hydrogen Helium Lithium Beryllium Boron Carbon Nitrogen Oxygen Fluorine Neon Sodium Magnesium Aluminium Silicon Phosphorus Sulfur Chlorine Argon Potassium Calcium Scandium Titanium Vanadium Chromium Manganese Iron Cobalt Nickel Copper Zinc Gallium Germanium Arsenic Selenium Bromine Krypton Rubidium Strontium Yttrium Zirconium Niobium Molybdenum Technetium Ruthenium Rhodium Palladium Silver Cadmium Indium Tin Antimony Tellurium Iodine Xenon Caesium Barium Lanthanum Cerium Praseodymium Neodymium Promethium Samarium Europium Gadolinium Terbium Dysprosium Holmium Erbium Thulium Ytterbium Lutetium Hafnium Tantalum Tungsten Rhenium Osmium Iridium Platinum Gold Mercury Thallium Lead Bismuth Polonium Astatine Radon Francium Radium Actinium Thorium Protactinium Uranium Neptunium Plutonium Americium Curium Berkelium Californium Einsteinium Fermium Mendelevium Nobelium Lawrencium Rutherfordium Dubnium Seaborgium Bohrium Hassium Meitnerium Darmstadtium Roentgenium Copernicium Nihonium Flerovium Moscovium Livermorium Tennessine Oganesson'
      : 'Hidrógeno Helio Litio Berilio Boro Carbono Nitrógeno Oxígeno Flúor Neón Sodio Magnesio Aluminio Silicio Fósforo Azufre Cloro Argón Potasio Calcio Escandio Titanio Vanadio Cromo Manganeso Hierro Cobalto Níquel Cobre Zinc Galio Germanio Arsénico Selenio Bromo Kriptón Rubidio Estroncio Itrio Circonio Niobio Molibdeno Tecnecio Rutenio Rodio Paladio Plata Cadmio Indio Estaño Antimonio Telurio Yodo Xenón Cesio Bario Lantano Cerio Praseodimio Neodimio Prometio Samario Europio Gadolinio Terbio Disprosio Holmio Erbio Tulio Iterbio Lutecio Hafnio Tantalio Wolframio Renio Osmio Iridio Platino Oro Mercurio Talio Plomo Bismuto Polonio Astato Radón Francio Radio Actinio Torio Protactinio Uranio Neptunio Plutonio Americio Curio Berkelio Californio Einstenio Fermio Mendelevio Nobelio Laurencio Rutherfordio Dubnio Seaborgio Bohrio Hasio Meitnerio Darmstatio Roentgenio Copernicio Nihonio Flerovio Moscovio Livermorio Teneso Oganesón').split(' ');
    const CA = cells.find((q) => q.s === 'Ca'), SE = cells.find((q) => q.s === 'Se');
    cells.forEach((q) => { q.dC = Math.hypot(q.x, q.v - CA.v); q.name = NAMES[q.z - 1]; q.d2Ca = (q.x - CA.x) ** 2 + (q.v - CA.v) ** 2; q.d2Se = (q.x - SE.x) ** 2 + (q.v - SE.v) ** 2; q.on = false; });
    /* nearest first is drawn last */
    cells.sort((a, b) => a.v - b.v);

    /* at rest an element lights up here and there. Which one and when comes from a hash of the time slot, so it reads as
       chance but the same moment always draws the same (a paused frame stays put). A flash rises fast and fades slowly,
       spills a little light on the squares around it, and there are never more than three at once */
    const POOL = cells.filter((q) => q !== CA && q !== SE);
    const hash = (n) => { const x = Math.sin(n * 127.1 + 311.7) * 43758.5453; return x - Math.floor(x); };
    const STEP = 1.05, LIFE = 3.1, flashes = [], touched = [];
    const envOf = (age) => (age < .5 ? easeOut(age / .5) : Math.exp(-(age - .5) * 1.5));
    const lightUp = (t) => {
      flashes.length = 0;
      /* a tile someone touched or clicked lights up at full strength */
      for (let i = touched.length - 1; i >= 0; i--) {
        const age = t - touched[i].t0;
        if (age > LIFE) touched.splice(i, 1); else flashes.push({ q: touched[i].q, env: envOf(Math.max(0, age)), own: true });
      }
      if (t < 2.7) return;                      /* first the table is laid and Ca and Se land */
      const k1 = Math.floor(t / STEP);
      for (let k = Math.max(0, k1 - 3); k <= k1; k++) {
        if (hash(k * 3.17) < .2) continue;       /* now and then a slot stays dark, so the rhythm is not a metronome */
        const age = t - k * STEP - hash(k + .5) * STEP * .7;
        if (age < 0 || age > LIFE) continue;
        const q = POOL[Math.floor(hash(k) * POOL.length)];
        if (touched.some((f) => f.q === q)) continue;
        const env = envOf(age) * (.75 + .25 * hash(k + .9));
        flashes.push({ q, env });
      }
    };
    /* Ca and Se land last: the table is laid without them and is complete when the brand arrives. Each lands with a small
       settle, and its square answers with a short glow that reaches the squares around it */
    const LAND = { Ca: 1.4, Se: 1.62 }, TOUCH = .44;
    const easeBack = (x) => 1 + 2.2 * (x - 1) ** 3 + 1.2 * (x - 1) ** 2;
    const landed = (q, t) => (RM ? 1 : clamp01((t - LAND[q.s]) / .8));
    const thud = (q, t) => (RM ? 0 : Math.exp(-(((t - LAND[q.s] - TOUCH) / .2) ** 2)));
    let pCa = 0, pSe = 0;
    const idle = (q) => {
      let v = Math.max(pCa * .5 * Math.exp(-q.d2Ca / 1.3), pSe * .5 * Math.exp(-q.d2Se / 1.3));
      for (const f of flashes) {
        if (f.q === q) { v = Math.max(v, f.env); continue; }
        const d2 = (q.x - f.q.x) ** 2 + (q.v - f.q.v) ** 2;
        if (d2 < 2.6) v = Math.max(v, f.env * .32 * Math.exp(-d2 / .9));
      }
      return v;
    };

    const D = 13;
    let W = 1, H = 1, DPR = 1, U0 = 60, CY0 = .66;
    const size = () => {
      SYMF = face('--sym'); TEXTF = face('--font');
      W = cv.clientWidth; H = cv.clientHeight; DPR = Math.min(2, devicePixelRatio || 1);
      cv.width = Math.round(W * DPR); cv.height = Math.round(H * DPR);
      /* the whole table at rest: under the copy, as large as the width or the free height allows, and in the middle of what is free */
      const th = W < 700 ? .74 : .9, c = Math.cos(th), s = Math.sin(th), sc = (v) => D / (D - v * s);
      const far = 2.8 * c * sc(-2.8), near = 5.75 * c * sc(5.75);        /* from the centre of the floor up to period 2 and down to the last row, in tiles */
      const cb = copy.offsetTop + copy.offsetHeight, gp = Math.min(44, Math.max(22, H * .045));
      U0 = Math.max(19, Math.min(W / 20.6, (H * 1.02 - cb - gp) / (far + near)));
      CY0 = (cb + Math.max(gp, (H - cb - (far + near) * U0) * .5) + far * U0) / H;
    };
    size();
    const m = pointer(stick, .12);
    let cosT = 1, sinT = 0, U = 60, cx = 0, cy = 0;
    /* a point on the tilted floor (x across, v toward the viewer, h above it) and the affine frame of a tile there, in 1/100 tile units */
    const at = (x, v, h, o) => {
      const py = v * cosT - h * sinT, s = D / (D - v * sinT - h * cosT);
      o.e = cx + x * s * U; o.f = cy + py * s * U; o.s = s;
      o.a = s * U / 100;
      o.c = x * U * s * s * sinT / D / 100; o.d = U * (cosT * s + py * s * s * sinT / D) / 100;
      return o;
    };
    const O = {}, A = {}, B = {};
    /* a soft light, eased so its edge never shows a ring */
    const glow = (x, y, rx, ry, rgb, a) => {
      if (a <= .004) return;
      ctx.save(); ctx.translate(x, y); ctx.scale(1, ry / rx);
      const g = ctx.createRadialGradient(0, 0, 0, 0, 0, rx);
      g.addColorStop(0, `rgba(${rgb},${a})`); g.addColorStop(.25, `rgba(${rgb},${(a * .72).toFixed(3)})`);
      g.addColorStop(.55, `rgba(${rgb},${(a * .28).toFixed(3)})`); g.addColorStop(1, `rgba(${rgb},0)`);
      ctx.fillStyle = g; ctx.fillRect(-rx, -rx, rx * 2, rx * 2); ctx.restore();
    };
    /* the tile's own light, built once in tile units and reused by every tile through its transform:
       a sheen that falls from the top edge, a core that lights it from within, and an edge brighter on top than below */
    const SHEEN = ctx.createLinearGradient(0, -46, 0, 46);
    SHEEN.addColorStop(0, 'rgba(160,196,255,.13)'); SHEEN.addColorStop(.38, 'rgba(160,196,255,.03)'); SHEEN.addColorStop(1, 'rgba(0,4,16,.22)');
    const CORE = ctx.createRadialGradient(0, 10, 0, 0, 10, 66);
    CORE.addColorStop(0, 'rgba(130,186,255,.85)'); CORE.addColorStop(.45, 'rgba(48,118,255,.5)'); CORE.addColorStop(1, 'rgba(30,85,224,0)');
    const EDGE = {};
    Object.values(TINT).forEach((rgb) => {
      const g = ctx.createLinearGradient(0, -46, 0, 46);
      g.addColorStop(0, `rgba(${rgb},1)`); g.addColorStop(1, `rgba(${rgb},.38)`);
      EDGE[rgb] = g;
    });
    /* the entrance: the table is laid tile by tile, in the order of the atomic numbers */
    const born = (z, t) => (RM ? 1 : easeOut(clamp01((t - .2 - z / 118 * .95) / .6)));
    const halos = [];
    let now = 0, label = null;
    const frame = (t, p) => {
      now = t;
      m.step();
      lightUp(t);
      pCa = thud(CA, t); pSe = thud(SE, t);
      /* the random flashes stay nameless; only a tile someone touched or clicked shows its name (the latest one) */
      let top = null;
      for (const f of flashes) if (f.own && (!top || f.env > top.env)) top = f;
      label = null;
      const cam = easeIO(range(p, .03, .5)), K = easeIO(range(p, .26, .7));
      const narrow = W < 700;
      /* a high camera at rest shows the outline of the table; on a phone it is the only way to recognise it */
      const TH = lerp(narrow ? .74 : .9, .6, cam);
      cosT = Math.cos(TH); sinT = Math.sin(TH); U = U0 * lerp(1, .82, cam); cx = W / 2; cy = H * lerp(CY0, .56, cam);
      const mx = m.x * W, my = m.y * H, sig = 2 * (1.9 * U) ** 2;
      ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
      ctx.globalAlpha = 1; ctx.globalCompositeOperation = 'source-over';
      ctx.clearRect(0, 0, W, H);
      /* the room: a horizon that glows behind the far rows, light that pools on the floor around Ca and Se, and a deep blue under the table */
      at(0, (0 - R0) * G - .8, 0, O);
      const hz = O.f, rest = 1 - K;
      glow(cx, hz, W * .78, H * .24, '22,72,210', (.26 * (1 - .55 * K)).toFixed(3));
      glow(cx, hz + H * .01, W * .42, H * .065, '96,156,255', (.2 * (1 - .7 * K)).toFixed(3));
      at(CA.x, CA.v, 0, A); at(SE.x, SE.v, 0, B);
      glow((A.e + B.e) / 2, (A.f + B.f) / 2, W * .46, H * .2, '30,96,255', (.15 * rest).toFixed(3));
      glow(cx, cy + H * .12, W * .72, H * .42, '14,46,150', (.2 * rest).toFixed(3));
      ctx.textBaseline = 'alphabetic';
      const showText = U >= 26;
      halos.length = 0;
      for (const q of cells) {
        const isLogo = q === CA || q === SE, a0 = born(q.z, t);        /* the two squares that have a tile floating over them */
        q.on = false;
        if (a0 <= 0) continue;
        at(q.x, q.v, 0, O);
        const hv = m.in * Math.exp(-((O.e - mx) ** 2 + (O.f - my) ** 2) / sig);
        const rg = isLogo ? 0 : idle(q) * rest;
        /* on the scroll the tiles sink and go dark from the middle of the row outward */
        const fall = clamp01(K * 2.4 - q.dC / 8);
        const h = (isLogo ? 0 : .5 * hv + .16 * rg - fall * 1.4) + (1 - a0) * 1.3;
        if (h !== 0) at(q.x, q.v, h, O);
        const far = clamp01((O.s - .74) / .36), vis = (.3 + .7 * far) * (1 - fall) * a0;
        if (vis <= .01) continue;
        const lit = Math.min(1, hv + rg), warm = Math.min(1, hv * .8 + rg * .9);
        ctx.setTransform(DPR * O.a, 0, DPR * O.c, DPR * O.d, DPR * O.e, DPR * O.f);
        ctx.globalAlpha = 1;
        if (h > .04) {            /* a lifted tile shows its edge */
          ctx.beginPath(); ctx.roundRect(-46, -46 + h * 26, 92, 92, 9);
          ctx.fillStyle = `rgba(6,16,58,${(.9 * vis).toFixed(3)})`; ctx.fill();
        }
        ctx.beginPath(); ctx.roundRect(-46, -46, 92, 92, 9);
        /* body: deep navy at rest, warming to the brand blue when it lights */
        ctx.fillStyle = isLogo ? `rgba(30,107,255,${(.14 * vis).toFixed(3)})`
          : `rgba(${Math.round(8 + 14 * warm)},${Math.round(17 + 52 * warm)},${Math.round(44 + 150 * warm)},${((.58 + .38 * warm) * vis).toFixed(3)})`;
        ctx.fill();
        ctx.globalAlpha = vis; ctx.fillStyle = SHEEN; ctx.fill();
        if (warm > .02) { ctx.globalAlpha = warm * vis; ctx.fillStyle = CORE; ctx.fill(); }
        ctx.globalAlpha = (isLogo ? .9 : .24 + .76 * lit) * vis;
        ctx.lineWidth = (1.1 + lit * 1.1) / O.a;
        ctx.strokeStyle = EDGE[q.tint]; ctx.stroke();
        ctx.globalAlpha = 1;
        if (showText && !isLogo) {
          const ta = (.4 + .6 * lit) * vis;
          ctx.fillStyle = `rgba(${Math.round(222 + 33 * lit)},${Math.round(232 + 23 * lit)},255,${ta.toFixed(3)})`;
          ctx.font = `600 38px ${SYMF}`; ctx.textAlign = 'left';
          ctx.fillText(q.s, -34, 32);
          if (O.a > .5) { ctx.fillStyle = `rgba(${q.tint},${(ta * .9).toFixed(3)})`; ctx.font = `500 13px ${SYMF}`; ctx.fillText(q.z, -33, -22); }
        }
        if (rg > .2) halos.push([O.e, O.f, O.a * 100, rg * vis]);
        /* where the tile is on screen, so a touch can find it */
        if (vis > .25) { q.on = true; q.e = O.e; q.f = O.f; q.a = O.a; q.c = O.c; q.d = O.d; }
        if (top && q === top.q) label = { x: O.e - O.c * 46, y: O.f - O.d * 46, al: clamp01((top.env - .12) / .35) * rest * vis, name: q.name };
      }
      /* the light a flash throws on the floor around it */
      ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
      ctx.globalCompositeOperation = 'lighter';
      for (const [x, y, s, a] of halos) glow(x, y, s * 1.5, s * .7, '52,124,255', (.4 * a).toFixed(3));
      const Tz = Math.min(Math.max(W * .15, 84), 190);
      /* the two logo tiles float over their squares, then leave the table and meet as the mark */
      [[CA, SPR.ca, -1], [SE, SPR.se, 1]].forEach(([q, spr, side]) => {
        const lt = landed(q, t); if (lt <= 0) return;
        const a0 = clamp01(lt * 2.4), hit = q === CA ? pCa : pSe;
        at(q.x, q.v, 0, O);
        const fx = O.e, fy = O.f, fs = O.a * 100;
        at(q.x, q.v, .7 + .1 * Math.sin(t * 1.3 + side) + (1 - easeBack(lt)) * 3.4, O);
        const k0 = Math.max(1, (narrow ? .34 : 0) / O.a);        /* on a phone the two tiles stay big enough to read */
        const a = lerp(O.a * k0, Tz / 100, K), c = lerp(O.c * k0, 0, K), d = lerp(O.d * k0, Tz / 100, K);
        const e = lerp(O.e, cx + side * .54 * Tz, K), f = lerp(O.f, H * .47, K) - Math.sin(Math.PI * K) * H * .05;
        ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
        ctx.globalCompositeOperation = 'lighter';
        /* the square it floats over is lit from above, and the tile carries a halo of its own */
        glow(fx, fy, fs * 1.6, fs * .72, '50,120,255', (.5 * rest * a0).toFixed(3));
        glow(fx, fy, fs * .7, fs * .32, '150,196,255', (.22 * rest * a0).toFixed(3));
        glow(fx, fy, fs * 2.6, fs * 1.15, '70,140,255', (.55 * hit * rest).toFixed(3));
        glow(e, f, a * 220, a * 220, '30,96,255', (.38 * a0).toFixed(3));
        ctx.globalCompositeOperation = 'source-over';
        ctx.globalAlpha = a0;
        ctx.setTransform(DPR * a, 0, DPR * c, DPR * d, DPR * e, DPR * f);
        ctx.drawImage(spr, -50, -50, 100, 100);
        ctx.globalAlpha = 1;
      });
      ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
      ctx.globalCompositeOperation = 'source-over';
      /* the corners fall into shadow so the eye stays on the middle */
      const vg = ctx.createRadialGradient(cx, H * .58, Math.min(W, H) * .32, cx, H * .58, Math.hypot(W, H) * .62);
      vg.addColorStop(0, 'rgba(2,4,10,0)'); vg.addColorStop(.6, 'rgba(2,4,10,.22)'); vg.addColorStop(1, 'rgba(2,4,10,.62)');
      ctx.fillStyle = vg; ctx.fillRect(0, 0, W, H);
      /* the name of the element that is lit, small, over its tile */
      if (label && label.al > .02) {
        ctx.font = `500 12px ${TEXTF}`; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
        const tw = ctx.measureText(label.name).width, ph = 22, y = label.y - 8 - ph / 2;
        ctx.globalAlpha = label.al;
        ctx.beginPath(); ctx.roundRect(label.x - tw / 2 - 10, y - ph / 2, tw + 20, ph, ph / 2);
        ctx.fillStyle = 'rgba(3,8,24,.86)'; ctx.fill();
        ctx.lineWidth = 1; ctx.strokeStyle = 'rgba(118,166,255,.42)'; ctx.stroke();
        ctx.fillStyle = '#e8f0ff'; ctx.fillText(label.name, label.x, y + .5);
        ctx.globalAlpha = 1; ctx.textAlign = 'left'; ctx.textBaseline = 'alphabetic';
      }
      /* the near edge fades into the page, on an eased curve so no band shows */
      const fg = ctx.createLinearGradient(0, H * .8, 0, H);
      fg.addColorStop(0, 'rgba(2,4,10,0)'); fg.addColorStop(.35, 'rgba(2,4,10,.18)'); fg.addColorStop(.7, 'rgba(2,4,10,.6)'); fg.addColorStop(1, 'rgba(2,4,10,.94)');
      ctx.fillStyle = fg; ctx.fillRect(0, H * .8, W, H * .2);
    };
    const cta = stick.querySelector('.nav__cta');
    /* it arrives away (Nav.astro), so it does not flash before the headline; with reduced motion the hero does not move and it stays */
    if (cta && RM) cta.classList.remove('is-away');
    const d = drive({
      area: stick, btn: stick.querySelector('.hx__pause'), sec, frame,
      scroll: (p) => { copyOut(copy, say, p, .64, .86); if (cta && !RM) cta.classList.toggle('is-away', p < .32); }
    });
    /* a touch or a click on a tile lights it up and shows its name. Nearest tiles are drawn last, so they are tried first */
    const onTap = (ev) => {
      if (ev.target.closest('a,button,input,label')) return;
      const r = cv.getBoundingClientRect(), x = ev.clientX - r.left, y = ev.clientY - r.top;
      for (let i = cells.length - 1; i >= 0; i--) {
        const q = cells[i];
        if (!q.on || q === CA || q === SE) continue;
        const v = (y - q.f) / q.d, u = (x - q.e - q.c * v) / q.a;
        if (Math.abs(u) > 50 || Math.abs(v) > 50) continue;
        for (let j = touched.length - 1; j >= 0; j--) if (touched[j].q === q) touched.splice(j, 1);
        /* with reduced motion nothing runs, so the tile is drawn already lit */
        touched.push({ q, t0: RM ? now - .5 : now });
        if (touched.length > 3) touched.shift();
        d.kick();
        return;
      }
    };
    stick.addEventListener('click', onTap);
    const onResize = () => { size(); d.kick(); };
    addEventListener('resize', onResize);
    /* when the font arrives the copy changes height */
    if (document.fonts) document.fonts.ready.then(onResize);
    return () => { d.cleanup(); m.off(); removeEventListener('resize', onResize); stick.removeEventListener('click', onTap); };
  }
});
</script>
