<style is:global>
/* ===== Social media (Cubo abierto, 23 November 2026). The six parts of the service are the six faces of a cube laid open: its net,
   a staircase of six faces that unfolds once when the section arrives. Each face opens on its fold line and starts its drawing as
   it lies flat. On a phone the net stands up, in two columns. Each face is an element (Ec 01 … Pu 06), its drawing and its
   sentence. Before, the stories turned on that cube, one at a time, in a frame (22 November 2026) ===== */
.sm{position:relative;background:var(--night);color:#fff}
.sm-in{padding:clamp(84px,12vh,120px) var(--gutter) clamp(64px,10vh,110px)}
.sm-lead{max-width:24em;color:rgba(var(--ice-rgb),.74)}
/* an element as the site draws it; lit, as the hero lights them */
.sm-el{--z:40px;position:relative;display:flex;flex-direction:column;flex:none;width:var(--z);height:var(--z);padding:calc(var(--z) * .1) calc(var(--z) * .11);border-radius:calc(var(--z) * .2);background:var(--cell);color:#fff;box-shadow:inset 0 0 0 1.5px rgba(var(--edge-rgb),.55)}
.sm-el i{font:400 max(9.5px,calc(var(--z) * .17))/1 var(--mono);font-style:normal;font-variant-numeric:tabular-nums;letter-spacing:.02em;color:var(--frost)}
.sm-el b{margin-top:auto;font:600 calc(var(--z) * .44)/.84 var(--sym);letter-spacing:-.045em}
.sm-el.is-lit{background:var(--lit);box-shadow:inset 0 0 0 1px rgba(170,204,255,.62),inset 0 1px 0 rgba(232,240,255,.4)}
.sm-el.is-lit i{color:#fff}
/* "Nuestro plus": a small tag beside the element of the two parts that are our edge */
.sm-plus{flex:none;padding:6px 9px;border-radius:8px;background:rgba(var(--sky-rgb),.16);box-shadow:inset 0 0 0 1px rgba(var(--sky-rgb),.3);color:var(--ice);font:600 12px/1 var(--font);font-style:normal;white-space:nowrap}

/* the cube, measured by one face (--s, sizeOf in the script). On a computer the net is a staircase of 2-2-2 in four columns and
   three rows: the title takes the two free squares at the top right, and the way to unfold it again the two at the bottom left */
.sm-cube{--s:280px;position:relative;width:calc(var(--s) * 4);height:calc(var(--s) * 3);margin-inline:auto;perspective:2000px;perspective-origin:10% 8%}
.sm-head{position:absolute;left:calc(var(--s) * 2);top:0;width:calc(var(--s) * 2);height:var(--s);display:grid;gap:12px;align-content:end;padding:0 0 clamp(20px,3vh,32px) clamp(22px,2.4vw,40px)}
.sm-side{position:absolute;left:0;top:calc(var(--s) * 2);width:calc(var(--s) * 2);height:var(--s);display:flex;flex-direction:column;align-items:flex-start;gap:14px;padding:clamp(22px,3vh,32px) clamp(20px,2.4vw,36px) 0 0}
.sm-cap{display:none;margin:0}
.sm-cap b{font:600 17px/1.15 var(--head);letter-spacing:-.02em}
.sm-cap span{max-width:30em;font-size:15px;line-height:1.45;color:rgba(var(--ice-rgb),.86)}
/* each face hangs from the one before by an edge: on its right (--r) or below it (--b). Folded, the hinges close the cube */
.sm-net,.sm-n{transform-style:preserve-3d}
.sm-net{position:absolute;left:0;top:0;width:var(--s);height:var(--s)}
.sm-n{position:absolute;width:var(--s);height:var(--s)}
.sm-n--r{left:100%;top:0;transform-origin:0 50%}
.sm-n--b{left:0;top:100%;transform-origin:50% 0}
/* a face: a square cut from the same night blue, with the light of a story from its side */
.sm-f{position:absolute;inset:0;display:flex;flex-direction:column;gap:clamp(8px,1.2vh,12px);min-width:0;padding:clamp(12px,1.2vw,16px);border-radius:4px;overflow:hidden;color:#fff;backface-visibility:hidden;container-type:inline-size;
  background:radial-gradient(90% 50% at var(--hx,50%) 0%,rgba(var(--cobalt-rgb),.42),rgba(var(--cobalt-rgb),0) 72%),radial-gradient(80% 40% at calc(100% - var(--hx,50%)) 104%,rgba(var(--cobalt-rgb),.3),rgba(var(--cobalt-rgb),0)),#040a1d;box-shadow:inset 0 0 0 1px rgba(var(--edge-rgb),.22)}
/* its fold line, dashed, on the edge it hangs from */
.sm-n--r>.sm-f::before,.sm-n--b>.sm-f::before{content:"";position:absolute;z-index:3;opacity:.55;pointer-events:none}
.sm-n--r>.sm-f::before{left:-1px;top:10px;bottom:10px;border-left:1.5px dashed var(--ice)}
.sm-n--b>.sm-f::before{top:-1px;left:10px;right:10px;border-top:1.5px dashed var(--ice)}
@media (hover:hover) and (pointer:fine){.sm-f{cursor:pointer}}
.sm-top{display:flex;align-items:flex-start;justify-content:space-between;gap:10px}
.sm-top .sm-el{--z:clamp(36px,10cqw,46px)}
/* the drawing is measured by its own box (container units), so it fits a face of any size */
.sm-art{position:relative;flex:1 1 auto;min-height:64px;display:grid;place-items:center;container-type:size}
.sm-txt{display:grid;gap:6px}
.sm-txt h3{font:600 clamp(18px,6.2cqw,27px)/1.06 var(--head);letter-spacing:-.03em;text-wrap:balance}
.sm-txt p{max-width:34em;font-size:clamp(13px,3.6cqw,15px);line-height:1.42;color:rgba(var(--ice-rgb),.86)}
/* a small face (under 262 px, and every face on a phone) does not have room for its sentence: it goes to the caption beside the
   cube, the one of the face that just opened or was touched. In the face it stays for screen readers */
.sm-cube.is-compact .sm-txt p{position:absolute;width:1px;height:1px;margin:-1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
.sm-cube.is-compact .sm-cap{display:grid;gap:6px}
/* standing, on a phone: the 3-3 net in two columns; the title in the two free squares at the top right, the caption and the way
   to unfold it again in the two at the bottom left */
.sm-cube.is-tall{width:calc(var(--s) * 2);height:calc(var(--s) * 5);perspective-origin:20% 6%}
.sm-cube.is-tall .sm-head{left:var(--s);top:0;width:var(--s);height:calc(var(--s) * 2);padding:0 0 18px 14px}
.sm-cube.is-tall .sm-head .h2{font-size:28px}
.sm-cube.is-tall .sm-lead{font-size:15px}
.sm-cube.is-tall .sm-side{left:0;top:calc(var(--s) * 3);width:var(--s);height:calc(var(--s) * 2);padding:18px 14px 0 0;gap:12px}
.sm-cube.is-tall .sm-cap span{font-size:14px}
.sm-again{display:inline-flex;align-items:center;gap:8px;min-height:44px;padding:0 16px;border:0;border-radius:999px;background:rgba(255,255,255,.07);box-shadow:inset 0 0 0 1px rgba(var(--edge-rgb),.3);color:#fff;font:600 14px/1 var(--font);cursor:pointer;transition:background-color var(--d-hover) ease,transform var(--d-hover) var(--ease-out)}
.sm-again svg{width:16px;height:16px;flex:none}
@media (hover:hover) and (pointer:fine){.sm-again:hover{background:rgba(255,255,255,.13)}}
.sm-again:active{transform:scale(.97)}
.sm-cube.is-tall .sm-again{padding:0 12px;font-size:13px}
.sm :focus-visible{outline:2px solid var(--focus);outline-offset:3px}
/* with reduced motion the cube is open and still. Where the faces are small, their six sentences are written under it */
.sm-list{display:none;margin:0;padding:0;list-style:none}
.sm.is-still .sm-cube.is-compact~.sm-list{display:grid;gap:16px;margin-top:28px}
.sm.is-still .sm-cube .sm-cap{display:none}
.sm-list li{display:grid;grid-template-columns:auto minmax(0,1fr);align-items:start;gap:14px}
.sm-li{margin:0;font-size:15px;line-height:1.45;color:rgba(var(--ice-rgb),.86)}
.sm-li b{display:block;margin-bottom:4px;font:600 17px/1.2 var(--head);letter-spacing:-.02em;color:#fff}

/* what each face draws. It waits as it was before the face opens, and plays once it lies flat (.is-cur) */
.sm-cal{display:grid;grid-template-columns:repeat(7,1fr);gap:clamp(3px,1.4cqw,6px);width:min(90cqw,160cqh,520px)}
.sm-cal i{position:relative;aspect-ratio:1;border-radius:22%;background:rgba(143,176,255,.1);box-shadow:inset 0 0 0 1px rgba(143,176,255,.18)}
.sm-cal i.on::before{content:attr(data-s);position:absolute;inset:0;display:grid;place-items:center;border-radius:inherit;font:600 min(4.6cqw,8cqh,26px)/1 var(--sym);font-style:normal;letter-spacing:-.03em;background:var(--lit);box-shadow:inset 0 0 0 1px rgba(170,204,255,.6);opacity:0;transform:scale(.4)}
.sm-f.is-cur .sm-cal i.on::before{opacity:1;transform:none;animation:smPop var(--d-enter) var(--ease-out) calc(160ms + var(--j) * 40ms) both}
@keyframes smPop{from{opacity:0;transform:scale(.4)}}
.sm-cam{position:relative;width:min(64cqh,72cqw);aspect-ratio:4/5}
.sm-shot{position:absolute;inset:0;border-radius:10px;background:50% 30%/cover no-repeat;opacity:0}
.sm-cam>i{position:absolute;width:16%;aspect-ratio:1;border:2px solid #eef3ff}
.sm-cam>i:nth-of-type(1){left:-8%;top:-6%;border-right:0;border-bottom:0;border-radius:9px 0 0 0}
.sm-cam>i:nth-of-type(2){right:-8%;top:-6%;border-left:0;border-bottom:0;border-radius:0 9px 0 0}
.sm-cam>i:nth-of-type(3){left:-8%;bottom:-6%;border-right:0;border-top:0;border-radius:0 0 0 9px}
.sm-cam>i:nth-of-type(4){right:-8%;bottom:-6%;border-left:0;border-top:0;border-radius:0 0 9px 0}
.sm-focus{position:absolute;left:50%;top:42%;width:24%;aspect-ratio:1;border:1.5px solid rgba(238,243,255,.9);border-radius:6px;opacity:0;transform:translate(-50%,-50%) scale(1.7)}
.sm-f.is-cur .sm-shot{opacity:1;animation:smDev var(--d-scene) var(--ease-out) 260ms both}
@keyframes smDev{0%{opacity:0}30%{opacity:1;filter:brightness(2.4)}100%{opacity:1;filter:none}}
.sm-f.is-cur .sm-focus{opacity:1;transform:translate(-50%,-50%);animation:smFocus var(--d-enter) var(--ease-out) both}
@keyframes smFocus{from{opacity:0;transform:translate(-50%,-50%) scale(1.7)}}
.sm-mg{display:grid;gap:min(14px,4cqh);width:min(92cqw,560px)}
.sm-run{position:relative;height:min(150px,46cqh)}
.sm-arc{position:absolute;inset:0;width:100%;height:100%;overflow:visible}
.sm-arc path{fill:none;stroke:rgba(143,176,255,.4);stroke-width:1.5;stroke-dasharray:2 5;vector-effect:non-scaling-stroke}
/* the element runs its arc and the playhead its timeline (--mt, 0..1, and the height of the jump, --my), moved by the script */
.sm-mx{position:absolute;left:0;bottom:4%;width:100%;height:0;transform:translate3d(calc(6% + var(--mt,0) * 88%),0,0)}
.sm-my{position:absolute;left:0;bottom:0;transform:translate3d(0,calc(-22cqh * var(--my,0)),0) rotate(calc((var(--mt,0) - .5) * 12deg))}
.sm-my .sm-el{--z:clamp(30px,13cqh,46px);transform:translate(-50%,0)}
.sm-tl{position:relative;display:grid;gap:min(6px,2cqh);padding:min(10px,3cqh) 0}
.sm-tr{position:relative;height:min(16px,5cqh);border-radius:5px;background:rgba(143,176,255,.12)}
.sm-tr i{position:absolute;top:50%;width:9px;height:9px;margin:-4.5px 0 0 -4.5px;border-radius:2px;background:var(--ice);transform:rotate(45deg)}
.sm-ph{position:absolute;top:0;bottom:0;left:calc(6% + var(--mt,0) * 88%);width:2px;margin-left:-1px;border-radius:1px;background:var(--sky)}
.sm-ai{position:relative;width:min(34cqw,56cqh);aspect-ratio:4/5}
.sm-ai>span{position:absolute;inset:0;border-radius:10px;box-shadow:0 14px 30px -14px rgba(0,3,14,.9),inset 0 0 0 1px rgba(var(--ice-rgb),.25)}
/* the pieces are drawn, in a brand's style: a disc, its mark and two lines of copy, laid out another way in each one. No client's
   real post is shown as made with AI (the user's call, 16 November 2026) */
.sm-pc{overflow:hidden;container-type:inline-size;background:var(--bg);color:var(--pk,#fff)}
.sm-pc-o{position:absolute;left:var(--ox);top:var(--oy);width:var(--os);aspect-ratio:1;border-radius:50%;background:var(--o);transform:translateX(-50%)}
.sm-pc-m{position:absolute;left:9%;top:7%;display:grid;place-items:end start;width:24%;aspect-ratio:1;padding:4% 5%;border-radius:18%;box-shadow:inset 0 0 0 1px currentColor;font:600 8.5cqw/.8 var(--sym);letter-spacing:-.045em}
.sm-pc-l{position:absolute;left:9%;bottom:16%;width:62%;height:4.6%;border-radius:99px;background:currentColor}
.sm-pc-l.is-s{bottom:8.5%;width:36%;opacity:.55}
.sm-v{opacity:0}
.sm-v em{position:absolute;right:8px;top:8px;padding:3px 6px;border-radius:6px;background:#eef3ff;color:var(--deep);font:600 10px/1 var(--font);font-style:normal}
.sm-f.is-cur .sm-v{opacity:1;transform:translate3d(calc((var(--j) - 1) * 70%),calc((1 - var(--j)) * (1 - var(--j)) * 10% - 12%),0) rotate(calc((var(--j) - 1) * 11deg)) scale(.84);animation:smFan var(--d-scene) var(--ease-out) calc(220ms + var(--j) * 90ms) both}
@keyframes smFan{from{opacity:0;transform:none}}
.sm-cm{display:grid;gap:min(10px,3cqh);width:min(88cqw,440px)}
.sm-cm p{display:grid;gap:min(6px,1.8cqh);width:72%;padding:min(12px,3.4cqh) 14px;border-radius:16px 16px 16px 4px;background:rgba(143,176,255,.14);opacity:0}
.sm-cm p.out{justify-self:end;border-radius:16px 16px 4px 16px;background:var(--cobalt)}
.sm-cm p i{display:block;height:max(4px,min(7px,2.2cqh));border-radius:4px;background:rgba(238,243,255,.55)}
.sm-cm p.out i{background:rgba(255,255,255,.85)}
.sm-f.is-cur .sm-cm p{opacity:1;animation:smUp var(--d-move) var(--ease-out) calc(200ms + var(--j) * 260ms) both}
@keyframes smUp{from{opacity:0;transform:translate3d(0,12px,0)}}
.sm-pu{display:grid;grid-template-columns:repeat(3,1fr);gap:3px;width:min(84cqw,64cqh)}
.sm-pu span{aspect-ratio:4/5;background:50% 30%/cover no-repeat}
.sm-pu span:first-child{border-radius:8px 0 0 0}.sm-pu span:nth-child(3){border-radius:0 8px 0 0}
.sm-pu span:nth-child(7){border-radius:0 0 0 8px}.sm-pu span:nth-child(9){border-radius:0 0 8px 0}
.sm-pu .sm-new{position:relative;z-index:1;box-shadow:0 0 0 2px #eef3ff;opacity:0;transform:translate3d(0,-40%,0) scale(1.5)}
.sm-f.is-cur .sm-pu .sm-new{opacity:1;transform:none;animation:smLand var(--d-scene) var(--ease-out) 260ms both}
@keyframes smLand{from{opacity:0;transform:translate3d(0,-40%,0) scale(1.5)}}
@media (prefers-reduced-motion:reduce){.sm-f *,.sm-f *::before{animation:none!important}}
</style>

<template id="tpl-sm"><section class="sm" id="redes" aria-labelledby="sm-h"><div class="sm-in">
  <div class="sm-cube">
    <div class="sm-head"><h2 class="h2" id="sm-h">Manejo de redes sociales</h2><p class="lead sm-lead">Lo que hacemos en tus redes, en seis partes.</p></div>
    <div class="sm-net"></div>
    <div class="sm-side"><p class="sm-cap" aria-hidden="true"><b></b><span></span></p><button class="sm-again" type="button"><svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M13 8a5 5 0 1 1-1.6-3.7M13 2.6v2.9h-2.9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>Abrir el cubo otra vez</button></div>
  </div>
  <ol class="sm-list" aria-hidden="true"></ol>
</div></section></template>

<script is:inline>
/* what the social media service covers; a third item marks the ones that are our edge */
const SOCIAL = [
  ['Estrategia y calendario', 'Definimos contigo los temas, los formatos y las fechas del mes.'],
  ['Fotos y videos', 'Producimos el contenido: sesiones de fotos, reels y piezas gráficas.'],
  ['Motion graphics', 'Animamos tus ideas en reels y piezas con movimiento, hechas por nosotros.', 1],
  ['Contenido con IA', 'Usamos inteligencia artificial para producir más piezas en el estilo de tu marca.', 1],
  ['Community management', 'Publicamos, respondemos comentarios, mensajes y reseñas, y cuidamos el tono de tu marca.'],
  ['Publicación', 'Programamos cada pieza con su fecha y la publicamos en tus redes.']
];
const PLUS = '<em class="sm-plus">Nuestro plus</em>';

/* the six parts as the faces of a cube that unfolds. The posts in the drawings are real ones from the brands in Marcas, in cobalt
   (herramientas/publicaciones.py) */
addSection('tabla', 'tpl-sm', 4, (root) => {
  const sec = root.querySelector('.sm'), inner = sec.querySelector('.sm-in'), cube = sec.querySelector('.sm-cube'), net = cube.querySelector('.sm-net');
  const cap = cube.querySelector('.sm-cap'), again = cube.querySelector('.sm-again'), list = sec.querySelector('.sm-list');
  const N = SOCIAL.length, SYM = ['Ec', 'Fv', 'Mg', 'Ai', 'Cm', 'Pu'], HX = [24, 76, 50, 30, 70, 50], AI = window.LANG && LANG.cur === 'en' ? 'AI' : 'IA', offs = [];
  const no = (i) => String(i + 1).padStart(2, '0'), post = (k) => `assets/redes/${k}.webp`;
  const on = (n, ev, fn, o) => { n.addEventListener(ev, fn, o); offs.push(() => n.removeEventListener(ev, fn, o)); };
  const el = (i, cls) => `<span class="sm-el ${cls || ''}" aria-hidden="true"><i>${no(i)}</i><b>${SYM[i]}</b></span>`;
  const lines = (...w) => w.map((x) => `<i style="width:${x}%"></i>`).join('');
  const DAYS = [[1, 'Rl'], [3, 'Ft'], [6, 'Pz'], [9, 'Ft'], [12, 'Rl'], [15, 'Pz'], [17, 'Ft'], [20, 'Rl'], [23, 'Ft'], [26, 'Pz']];
  /* the pieces of the AI face, drawn: three made in the style of the last one (the one behind), each with its colours and its disc
     in another place */
  const PIECE = ['--bg:var(--deep);--o:var(--sky);--ox:50%;--oy:-16%;--os:98%', '--bg:var(--ice);--o:var(--cobalt);--ox:68%;--oy:26%;--os:58%;--pk:var(--deep)',
    '--bg:var(--cobalt-deep);--o:rgba(var(--ice-rgb),.32);--ox:24%;--oy:34%;--os:118%', '--bg:var(--cobalt);--o:rgba(var(--ice-rgb),.92);--ox:62%;--oy:14%;--os:70%'];
  const FEED = ['oneillcolombia-1', 'speedocolombia-1', 'weedhoney-3', 'graduadoseafit-1', 'lamigueria-2', 'oneillcolombia-8', 'agilcash-3', 'speedocolombia-8', 'oneillcolombia-4'];
  /* the drawing of each face: the month and its planned days, a frame in the viewfinder, an element moving over its timeline,
     more pieces in the same style fanning out from one (drawn), the conversation where every message gets its answer, and the new
     post going in first in the profile */
  const ART = [
    () => `<div class="sm-cal">${Array.from({ length: 28 }, (_, d) => { const x = DAYS.find((y) => y[0] === d); return x ? `<i class="on" data-s="${x[1]}" style="--j:${DAYS.indexOf(x)}"></i>` : '<i></i>'; }).join('')}</div>`,
    () => `<div class="sm-cam"><span class="sm-shot" style="background-image:url(${post('oneillcolombia-1')})"></span><i></i><i></i><i></i><i></i><span class="sm-focus"></span></div>`,
    () => `<div class="sm-mg"><div class="sm-run"><svg class="sm-arc" viewBox="0 0 100 40" preserveAspectRatio="none"><path d="M6 34 Q50 -10 94 34"/></svg><span class="sm-mx"><span class="sm-my"><span class="sm-el is-lit"><i>119</i><b>Tú</b></span></span></span></div><div class="sm-tl">${[[6, 50, 94], [6, 30, 72], [20, 60, 94]].map((r) => `<div class="sm-tr">${r.map((x) => `<i style="left:${x}%"></i>`).join('')}</div>`).join('')}<span class="sm-ph"></span></div></div>`,
    () => `<div class="sm-ai">${PIECE.map((st, j) => `<span class="sm-pc${j < 3 ? ' sm-v' : ''}" style="--j:${j};${st}"><i class="sm-pc-o"></i><b class="sm-pc-m">Tú</b><i class="sm-pc-l"></i><i class="sm-pc-l is-s"></i>${j < 3 ? `<em>${AI}</em>` : ''}</span>`).join('')}</div>`,
    () => `<div class="sm-cm"><p style="--j:0">${lines(80, 52)}</p><p class="out" style="--j:1">${lines(86, 60)}</p><p style="--j:2">${lines(64)}</p><p class="out" style="--j:3">${lines(70)}</p></div>`,
    () => `<div class="sm-pu">${FEED.map((k, j) => `<span${j ? '' : ' class="sm-new"'} style="background-image:url(${post(k)})"></span>`).join('')}</div>`
  ];
  const face = (i) => `<article class="sm-f" data-i="${i}" style="--hx:${HX[i]}%" aria-labelledby="sm-t-${i}"><div class="sm-top">${el(i, 'is-lit')}${SOCIAL[i][2] ? PLUS : ''}</div><div class="sm-art" aria-hidden="true">${ART[i]()}</div><div class="sm-txt"><h3 id="sm-t-${i}">${SOCIAL[i][0]}</h3><p>${SOCIAL[i][1]}</p></div></article>`;
  list.innerHTML = SOCIAL.map(([t, d, pl], i) => `<li>${el(i, 'is-lit')}<p class="sm-li"><b>${t}${pl ? ` ${PLUS}` : ''}</b>${d}</p></li>`).join('');

  /* a face plays its drawing from the start. The motion graphics one moves Tú along its arc and the playhead along its timeline
     (--mt, --my) for 2.6 s */
  let mt = 0;
  const motion = (f) => {
    cancelAnimationFrame(mt);
    if (RM) { f.style.setProperty('--mt', '.5'); f.style.setProperty('--my', '1'); return; }
    const t0 = performance.now();
    const step = (now) => {
      const k = clamp01((now - t0 - 240) / 2600), e = easeIO(k);
      f.style.setProperty('--mt', e.toFixed(4)); f.style.setProperty('--my', Math.sin(Math.PI * e).toFixed(4));
      if (k < 1) mt = requestAnimationFrame(step);
    };
    mt = requestAnimationFrame(step);
  };
  const played = new WeakMap();
  const play = (f) => {
    played.set(f, performance.now());
    f.classList.remove('is-cur'); void f.offsetWidth; f.classList.add('is-cur');
    if (+f.dataset.i === 2) motion(f);
  };
  const caption = (i) => { cap.firstElementChild.textContent = SOCIAL[i][0]; cap.lastElementChild.textContent = SOCIAL[i][1]; };

  /* the net. On a computer, a staircase of 2-2-2; on a phone, the 3-3 net standing. Each face hangs from the one before by an edge
     (r: on its right, b: below it); folded, both close into a cube, and only the first face shows, with the side of the second */
  const SHAPE = { wide: ['', 'r', 'b', 'r', 'b', 'r'], tall: ['', 'b', 'b', 'r', 'b', 'b'] };
  const narrow = matchMedia('(max-width:860px)');
  let shape = '', faces = [], hinges = [], raf = 0, opened = false;
  const angle = (i, a) => { const h = hinges[i]; if (h) h.style.transform = h.dataset.side === 'r' ? `rotateY(${a.toFixed(2)}deg)` : `rotateX(${(-a).toFixed(2)}deg)`; };
  const build = () => {
    shape = narrow.matches ? 'tall' : 'wide';
    cube.classList.toggle('is-tall', shape === 'tall');
    net.innerHTML = ''; faces = []; hinges = [];
    let parent = net;
    SHAPE[shape].forEach((side, i) => {
      const n = document.createElement('div');
      n.className = 'sm-n' + (side ? ` sm-n--${side}` : '');
      if (side) n.dataset.side = side;
      n.innerHTML = face(i);
      parent.appendChild(n); parent = n;
      faces[i] = n.firstElementChild; hinges[i] = side ? n : null;
    });
  };
  /* one face: a quarter of the width on a computer (and no more than a third of the screen's height, so the cube is seen whole),
     half of it on a phone */
  const size = () => {
    const cs = getComputedStyle(inner), W = inner.clientWidth - parseFloat(cs.paddingLeft) - parseFloat(cs.paddingRight);
    const s = shape === 'tall' ? Math.floor(W / 2) : Math.floor(Math.min(W / 4, 380, Math.max(250, innerHeight * .31)));
    cube.style.setProperty('--s', `${s}px`);
    cube.classList.toggle('is-compact', shape === 'tall' || s < 262);
  };
  const fold = () => { for (let i = 1; i < N; i++) angle(i, 90); };
  const flat = () => { cancelAnimationFrame(raf); for (let i = 1; i < N; i++) angle(i, 0); faces.forEach(play); caption(0); };
  /* the cube opens face by face: each hinge turns from 90° to flat, the next starting before the last one lands, and a face plays
     its drawing as it lies flat. About 3.4 s */
  const unfold = () => {
    cancelAnimationFrame(raf);
    faces.forEach((f) => f.classList.remove('is-cur'));
    fold(); play(faces[0]); caption(0);
    const t0 = performance.now(), landed = [];
    const tick = (now) => {
      let left = false;
      for (let i = 1; i < N; i++) {
        const k = clamp01((now - t0 - 420 - (i - 1) * 560) / 780);
        angle(i, 90 * (1 - easeIO(k)));
        if (k >= 1 && !landed[i]) { landed[i] = true; play(faces[i]); caption(i); }
        if (k < 1) left = true;
      }
      if (left) raf = requestAnimationFrame(tick);
    };
    raf = requestAnimationFrame(tick);
  };
  build(); size();
  /* touching a face plays its drawing again and brings its sentence to the caption */
  on(net, 'click', (e) => { const f = e.target.closest('.sm-f'); if (f) { play(f); caption(+f.dataset.i); } });
  /* with the mouse, passing over a face plays it again, if it is not playing already */
  on(net, 'pointerover', (e) => { const f = e.target.closest('.sm-f'); if (f && e.pointerType === 'mouse' && opened && performance.now() - (played.get(f) || 0) > 1600 && !f.contains(e.relatedTarget)) play(f); });
  on(window, 'resize', () => {
    const want = narrow.matches ? 'tall' : 'wide';
    if (want !== shape) { cancelAnimationFrame(raf); build(); if (RM || opened) flat(); else fold(); }
    size();
  });
  if (RM) { sec.classList.add('is-still'); again.hidden = true; flat(); return () => offs.forEach((f) => f()); }
  on(again, 'click', unfold);
  fold();
  /* it opens once, when a good part of its first face is on screen */
  const io = new IntersectionObserver((es) => { const e = es[es.length - 1]; if (e.isIntersecting && e.intersectionRatio >= .3 && !opened) { opened = true; io.disconnect(); unfold(); } }, { threshold: [0, .3] });
  io.observe(net);
  return () => { io.disconnect(); cancelAnimationFrame(raf); cancelAnimationFrame(mt); offs.forEach((f) => f()); };
});
</script>
