<style is:global>
/* ===== Footer: the periodic table is the menu. Periods one to five with their real symbols; the studio is in its cells (the sections
   and the services are links, Ca and Se are the name, back to top is helium's corner) and the gap of the table holds the contact and
   the key to its colours. Arriving, the camera lifts the table until it faces the visitor; under it, the logo ===== */
.ft{position:relative;background:var(--ft-bg);color:var(--ft-fg);font-size:15px;line-height:1.45}
.ft a{text-decoration:none}
.ft a:not(.btn){color:inherit}
.ft p{margin:0}
.ft :is(a,button):focus-visible{outline:2px solid var(--focus);outline-offset:3px}
/* the footer opens with the other half of the light that closed the last section */
:is(.v-tab)>.ft{background-image:radial-gradient(62vw 34vh at 50% 0%,var(--join),transparent 72%);background-repeat:no-repeat}
.ft--tabla{--ft-bg:var(--night);--ft-fg:#fff;--ft-dim:#9fb0d6;overflow:hidden}
.ft-in{position:relative;padding:clamp(28px,5vh,56px) var(--gutter) 24px}
/* the camera looks at the table from above; arriving, the table stands up until it faces the visitor */
.ft-stage{perspective:1100px;perspective-origin:50% 0}
.ft-plane{transform-origin:50% 100%;will-change:transform}
.ft-table{display:grid;grid-template-columns:repeat(18,minmax(0,1fr));gap:6px}
/* a cell of the table, in the real outline; the ones that are only table keep their symbol, faint */
.ft-c{position:relative;display:grid;align-content:space-between;justify-items:start;aspect-ratio:1/1.08;min-width:0;padding:6px 7px 7px;border:0;border-radius:9px;background:#050b1f;box-shadow:inset 0 0 0 1px rgba(var(--edge-rgb),.14);color:#2a3d70;font:inherit;text-align:left;transition:background-color var(--d-scene) ease,color var(--d-scene) ease}
.ft-c small{font:400 10px/1 var(--mono);font-variant-numeric:tabular-nums;letter-spacing:.02em}
.ft-c b{font:600 clamp(13px,1.15vw,17px)/.9 var(--sym);letter-spacing:-.03em}
/* a flash of the hero, on a cell that is only table */
.ft-c.fl{background:#0d1d4a;color:var(--frost);transition-duration:var(--d-hover)}
/* the studio's cells, by kind, as the families of a real table: sections, services and the name */
.ft-l{color:#fff;transition:background-color var(--d-fade) ease,color var(--d-fade) ease,box-shadow var(--d-fade) ease}
.ft-l small{color:var(--frost)}
.ft-l b{font-size:clamp(17px,1.6vw,24px);letter-spacing:-.04em}
.ft-l em{font:500 11px/1.15 var(--font);font-style:normal;color:var(--ft-dim);overflow-wrap:anywhere}
.ft-nav{background:var(--cell);box-shadow:inset 0 0 0 1px rgba(var(--edge-rgb),.7)}
.ft-svc{background:var(--cobalt);box-shadow:none}
.ft-svc small,.ft-svc em{color:#d6e3ff}
.ft-ca{background:#fff;box-shadow:none;color:var(--night)}
.ft-ca small,.ft-ca em{color:#33487f}
.ft-se{background:var(--night);box-shadow:inset 0 0 0 2px #fff}
.ft-top{background:var(--night);box-shadow:inset 0 0 0 1.5px var(--frost);cursor:pointer}
.ft-up{width:18px;height:18px}
@media (hover:hover) and (pointer:fine){a.ft-l:hover,button.ft-l:hover{background:#fff;box-shadow:none;color:var(--deep)}a.ft-l:hover :is(small,em),button.ft-l:hover :is(small,em){color:#33487f}}
/* the gap of the table, where the posters put their title: the contact, and the key to the colours, as a real table has */
.ft-gap{grid-area:1/3/4/13;align-self:center;display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:20px 40px;padding:0 clamp(10px,2vw,36px);color:var(--ft-dim)}
.ft-me{display:grid;gap:12px}
.ft-me p:first-child{color:#fff}
/* available: a small square in the blue of the page */
.ft-free{display:inline-flex;align-items:center;gap:10px;color:var(--ice)}
.ft-free::before{content:"";flex:none;width:8px;height:8px;border-radius:2px;background:var(--sky)}
.ft-key{display:flex;flex-wrap:wrap;gap:8px 20px;margin:0;padding:0;list-style:none;font-size:13px}
.ft-key li{display:inline-flex;align-items:center;gap:8px}
.ft-key i{width:14px;height:14px;border-radius:4px}
.ft-k-nav{background:var(--cell);box-shadow:inset 0 0 0 1px rgba(var(--edge-rgb),.7)}
.ft-k-svc{background:var(--cobalt)}
.ft-k-ca{background:#fff}
/* the logo, as wide as the table, rising from below as the page ends */
.ft-logo{margin-top:clamp(36px,6vh,72px);overflow:hidden}
.ft-mark{display:block;width:100%;height:auto;fill:#fff;will-change:transform}
/* (with .ft: ".ft p" would take its margin away and glue the line to the logo) */
.ft .ft-legal{margin-top:clamp(28px,4vh,44px);font-size:14px;color:var(--ft-dim)}
/* narrower, the cells keep their symbol, and their name stays for screen readers */
/* narrower, a name does not fit in its cell (about 49 px at 1024): it comes over the cell when the cursor or the focus is on it, as
   the names of the menu row do; the cell keeps its aria-label */
@media (min-width:861px) and (max-width:1200px){
  .ft-l em{position:absolute;left:50%;bottom:calc(100% + 8px);z-index:2;padding:6px 9px;border-radius:7px;background:#fff;color:var(--deep);font:500 12px/1 var(--font);white-space:nowrap;overflow-wrap:normal;opacity:0;transform:translate(-50%,4px);transition:opacity var(--d-fade) ease,transform var(--d-state) var(--ease-out);pointer-events:none}
  .ft-l:is(:hover,:focus-visible) em{opacity:1;transform:translate(-50%,0)}
}
/* wide, the names take one or two lines: their row is the same in every cell, so the symbols stand in one line */
@media (min-width:1201px){.ft-l{grid-template-rows:auto 1fr 2.3em}}
/* ===== On the phone (Mapa, chosen on 15 November 2026): the whole table, small, is a map with the studio's cells lit where they
   live; under it the sections and the services by name, each with its number in the table, and touching one lights its cell in the
   map; then the contact, back to top and the logo ===== */
.ft-mob{display:none}
@media (max-width:860px){
  .ft-stage{display:none}
  .ft-mob{display:grid;gap:26px}
  .ft-in{padding-top:clamp(32px,5vh,48px);padding-bottom:max(24px,env(safe-area-inset-bottom))}
  .ft-logo{margin-top:40px}
  .ft .ft-legal{margin-top:28px}
}
/* the map: a place is a few pixels, so only the studio's cells say their symbol; they light up in the order of the lists */
.ft-map{display:grid;grid-template-columns:repeat(18,minmax(0,1fr));gap:2px}
.ft-m{display:grid;place-items:center;aspect-ratio:1;border-radius:3px;background:#050b1f;box-shadow:inset 0 0 0 1px rgba(var(--edge-rgb),.13);transition:background-color var(--d-enter) ease,box-shadow var(--d-enter) ease;transition-delay:calc(var(--d,0) * 70ms)}
.ft-m b{font:600 clamp(7px,2.1vw,9px)/1 var(--sym);letter-spacing:-.04em;color:transparent;transition:color var(--d-enter) ease;transition-delay:inherit}
.ft-mob.is-lit .ft-m-nav{background:var(--cell);box-shadow:inset 0 0 0 1px rgba(var(--edge-rgb),.85)}
.ft-mob.is-lit .ft-m-svc{background:var(--cobalt);box-shadow:none}
.ft-mob.is-lit .ft-m-ca{background:#fff;box-shadow:none}
.ft-mob.is-lit .ft-m-se{background:var(--night);box-shadow:inset 0 0 0 1.5px #fff}
.ft-mob.is-lit .ft-m-top{box-shadow:inset 0 0 0 1px var(--frost)}
.ft-mob.is-lit .ft-m:is(.ft-m-nav,.ft-m-svc,.ft-m-se) b{color:#fff}
.ft-mob.is-lit .ft-m-ca b{color:var(--night)}
.ft-m.hot{background:#fff!important;box-shadow:0 0 0 2px rgba(var(--sky-rgb),.55)!important;transition-delay:0s;transition-duration:var(--d-hover)}
.ft-m.hot b{color:var(--deep)!important;transition-delay:0s}
/* the two lists: each row its element (with its number in the table) and its name */
.ft-lists{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}
.ft .ft-lk{margin:0 0 8px;font:600 12px/1 var(--font);letter-spacing:0;color:var(--frost)}
.ft-lists ul{display:grid;gap:2px;margin:0;padding:0;list-style:none}
.ft-row{display:flex;align-items:center;gap:10px;min-height:48px;padding:4px 6px 4px 4px;border-radius:12px;font:500 14px/1.15 var(--font);transition:background-color var(--d-hover) ease}
.ft-row:active{background:rgba(var(--glow-rgb),.18)}
.ft-el{display:grid;align-content:space-between;justify-items:start;flex:none;width:40px;height:40px;padding:4px 5px;border-radius:9px}
.ft-el i{font:400 9.5px/1 var(--mono);font-style:normal;font-variant-numeric:tabular-nums;letter-spacing:.02em}
.ft-el b{font:600 15px/1 var(--sym);letter-spacing:-.04em}
.ft-el-nav{background:var(--cell);box-shadow:inset 0 0 0 1px rgba(var(--edge-rgb),.7)}
.ft-el-nav i{color:var(--frost)}
.ft-el-svc{background:var(--cobalt)}
.ft-el-svc i{color:#d6e3ff}
.ft-mme{display:grid;gap:4px;color:var(--ft-dim)}
.ft-mme .ft-free{margin-top:6px}
.ft-mail{font:500 18px/1.3 var(--font);letter-spacing:-.01em;color:#fff}
.ft-back{justify-self:start;display:inline-flex;align-items:center;gap:8px;min-height:48px;padding:0 20px 0 16px;border:0;border-radius:999px;background:rgba(238,243,255,.07);box-shadow:inset 0 0 0 1px rgba(143,176,255,.4);color:#fff;font:500 15px/1 var(--font);cursor:pointer;transition:transform var(--d-hover) var(--ease-out)}
.ft-back:active{transform:scale(.97)}
@media (prefers-reduced-motion:reduce){.ft-c{transition:background-color var(--d-fade) ease,color var(--d-fade) ease}.ft-m,.ft-m b,.ft-back{transition:none}}
</style>

<script is:inline>
/* the sections, with the symbols of the fixed menu (the fourth is its English one), the four services (with where each leads) and
   the sample contact. Redes is not among the sections: its service, Redes sociales (Rs), already leads there, and in a table a
   symbol is one cell */
const FT = {
  nav: [['Servicios', '#servicios', 'Sv'], ['Rediseño', '#rediseno', 'Rd'], ['Proyectos', '#proyectos', 'Py', 'Pj'], ['Marcas', '#marcas', 'Mc', 'Br'], ['Proceso', '#proceso', 'Pc'], ['Preguntas', '#preguntas', 'Pr', 'Qs'], ['Contacto', '#contacto', 'Co']],
  svc: [['Sitios web', 'Sw', '#servicios'], ['Tiendas en línea', 'Ti', '#servicios'], ['Redes sociales', 'Rs', '#redes'], ['Marca', 'Ma', '#servicios']],
  mail: 'hola@casestudio.example', place: 'Medellín, Colombia', free: 'Disponibles para nuevos proyectos'
};
/* the real table, periods one to five, and where each atomic number sits in it */
const FT_PT = 'H He Li Be B C N O F Ne Na Mg Al Si P S Cl Ar K Ca Sc Ti V Cr Mn Fe Co Ni Cu Zn Ga Ge As Se Br Kr Rb Sr Y Zr Nb Mo Tc Ru Rh Pd Ag Cd In Sn Sb Te I Xe'.split(' ');
const ftAt = (z) => (z === 1 ? [1, 1] : z === 2 ? [1, 18] : z <= 10 ? [2, z <= 4 ? z - 2 : z + 8] : z <= 18 ? [3, z <= 12 ? z - 10 : z] : z <= 36 ? [4, z - 18] : [5, z - 36]);
const FT_UP = '<svg class="ft-up" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M8 13V3M4 7l4-4 4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>';

window.FOOT = {
  tabla: () => {
    const en = !!(window.LANG && LANG.cur === 'en');
    /* what each cell holds: Ca and Se, the name, in their own places; the services after calcium (Ti in titanium's); the sections in
       period five and Contacto in cobalt's (Co); back to top in helium's corner. "o" is the order of the menu on the phone */
    const m = { 2: { kind: 'top', o: 30 }, 20: { kind: 'ca', s: 'Ca', name: 'Calcio' }, 34: { kind: 'se', s: 'Se', name: 'Selenio' } };
    FT.svc.forEach(([name, s, href], i) => { m[21 + i] = { kind: 'svc', s, name, href, o: 20 + i }; });
    FT.nav.forEach(([name, href, s, sEn], i) => { m[href === '#contacto' ? 27 : 37 + i] = { kind: 'nav', s: en && sEn ? sEn : s, name, href, o: 10 + i }; });
    let cells = '';
    for (let z = 1; z <= FT_PT.length; z++) {
      const [r, c] = ftAt(z), o = m[z], no = String(z).padStart(2, '0'), st = `grid-area:${r}/${c}${o && o.o ? `;--o:${o.o}` : ''}`;
      if (!o) cells += `<i class="ft-c" style="${st}" aria-hidden="true"><small>${z}</small><b>${FT_PT[z - 1]}</b></i>`;
      else if (o.kind === 'top') cells += `<button class="ft-c ft-l ft-top" type="button" style="${st}" aria-label="Volver arriba"><small>${no}</small>${FT_UP}<em>Volver arriba</em></button>`;
      else if (o.href) cells += `<a class="ft-c ft-l ft-${o.kind}" href="${o.href}" style="${st}" aria-label="${o.name}"><small>${no}</small><b>${o.s}</b><em>${o.name}</em></a>`;
      else cells += `<span class="ft-c ft-l ft-${o.kind}" style="${st}" aria-hidden="true"><small>${no}</small><b>${o.s}</b><em>${o.name}</em></span>`;
    }
    const key = '<ul class="ft-key" aria-hidden="true"><li><i class="ft-k-nav"></i>Secciones</li><li><i class="ft-k-svc"></i>Servicios</li><li><i class="ft-k-ca"></i>CaSe</li></ul>';
    /* on the phone: the table as a map, the studio's cells lit in the order of the lists (sections, services, Ca, Se, back to top);
       the lists with each one's number in the table; the contact; back to top */
    const order = (o) => (o.kind === 'nav' ? o.o - 10 : o.kind === 'svc' ? o.o - 14 : { ca: 10, se: 11, top: 12 }[o.kind]);
    let map = '';
    for (let z = 1; z <= FT_PT.length; z++) {
      const [r, c] = ftAt(z), o = m[z];
      map += o ? `<i class="ft-m ft-m-${o.kind}" style="grid-area:${r}/${c};--d:${order(o)}"${o.href ? ` data-z="${z}"` : ''}>${o.s ? `<b>${o.s}</b>` : ''}</i>` : `<i class="ft-m" style="grid-area:${r}/${c}"></i>`;
    }
    const row = (z) => `<li><a class="ft-row" href="${m[z].href}" data-z="${z}"><span class="ft-el ft-el-${m[z].kind}" aria-hidden="true"><i>${z}</i><b>${m[z].s}</b></span><span>${m[z].name}</span></a></li>`;
    const navZ = FT.nav.map(([, href], i) => (href === '#contacto' ? 27 : 37 + i)), svcZ = FT.svc.map((_, i) => 21 + i);
    const mob = `<div class="ft-mob"><div class="ft-map" aria-hidden="true">${map}</div>
      <nav class="ft-lists" aria-label="Pie de página"><div><p class="ft-lk">Secciones</p><ul>${navZ.map(row).join('')}</ul></div><div><p class="ft-lk">Servicios</p><ul>${svcZ.map(row).join('')}</ul></div></nav>
      <div class="ft-mme"><p class="ft-mail">${FT.mail}</p><p>${FT.place}</p><p class="ft-free">${FT.free}</p></div>
      <button class="ft-back" type="button">${FT_UP}<span>Volver arriba</span></button></div>`;
    return `<div class="ft-in"><div class="ft-stage"><nav class="ft-plane ft-table" aria-label="Pie de página">${cells}<div class="ft-gap"><div class="ft-me"><p>${FT.mail}<br>${FT.place}</p><p class="ft-free">${FT.free}</p></div>${key}</div></nav></div>
      ${mob}<div class="ft-logo"><svg class="ft-mark" role="img" aria-label="CaSe Studio" viewBox="0 0 959.36 250"><use href="#logo-cut"></use></svg></div>
      <p class="ft-legal">© 2026 CaSe Studio</p></div>`;
  }
};
window.FOOT_INIT = {
  /* arriving, the camera lifts the table until it faces the visitor, and then lets go of the 3D so the menu reads sharp (on the phone
     it is a plain grid); the logo rises from below as the page ends; and the calm flashes of the hero fall on the cells that are only
     table, one at a time, never on a beat, while the footer is on screen */
  tabla: (ft) => {
    const plane = ft.querySelector('.ft-plane'), mark = ft.querySelector('.ft-mark'), plain = [...ft.querySelectorAll('.ft-c:not(.ft-l)')];
    const narrow = () => innerWidth <= 860;
    let raf = 0, t = 0;
    const calc = () => {
      raf = 0;
      const r = ft.getBoundingClientRect(), p = RM ? 1 : clamp01((innerHeight - r.top) / Math.min(r.height, innerHeight * .9));
      const k = easeIO(range(p, 0, .8)), km = easeOut(range(p, .5, 1));
      plane.style.transform = narrow() || k >= 1 ? '' : `rotateX(${lerp(68, 0, k).toFixed(2)}deg) scale(${lerp(.94, 1, k).toFixed(4)})`;
      mark.style.transform = km >= 1 ? '' : `translate3d(0,${((1 - km) * 102).toFixed(2)}%,0)`;
    };
    const q = () => { if (!raf) raf = requestAnimationFrame(calc); };
    addEventListener('scroll', q, { passive: true }); addEventListener('resize', q); calc();
    const flash = () => {
      if (ft.getBoundingClientRect().top < innerHeight && !narrow()) { const el = plain[Math.floor(Math.random() * plain.length)]; el.classList.add('fl'); setTimeout(() => el.classList.remove('fl'), 900); }
      t = setTimeout(flash, 1000 + Math.random() * 2200);
    };
    if (!RM) t = setTimeout(flash, 900);
    /* on the phone: the map lights the studio's cells the first time it is seen; a row touched, pointed at or focused lights its cell
       in the map; and back to top */
    const mob = ft.querySelector('.ft-mob'), offs = [];
    const on = (n, ev, fn) => { n.addEventListener(ev, fn); offs.push(() => n.removeEventListener(ev, fn)); };
    let io = null;
    if (RM) mob.classList.add('is-lit');
    else { io = new IntersectionObserver((es) => { if (es.some((e) => e.isIntersecting)) { mob.classList.add('is-lit'); io.disconnect(); } }, { threshold: .35 }); io.observe(mob.querySelector('.ft-map')); }
    mob.querySelectorAll('.ft-row').forEach((r) => {
      const cell = mob.querySelector(`.ft-m[data-z="${r.dataset.z}"]`), hot = (v) => () => { if (cell) cell.classList.toggle('hot', v); };
      ['pointerenter', 'focus', 'pointerdown'].forEach((ev) => on(r, ev, hot(true)));
      ['pointerleave', 'blur', 'pointercancel'].forEach((ev) => on(r, ev, hot(false)));
    });
    on(mob.querySelector('.ft-back'), 'click', () => (window.JUMP ? JUMP(0) : scrollTo({ top: 0, behavior: RM ? 'auto' : 'smooth' })));
    return () => { removeEventListener('scroll', q); removeEventListener('resize', q); cancelAnimationFrame(raf); clearTimeout(t); if (io) io.disconnect(); offs.forEach((f) => f()); };
  }
};
</script>
