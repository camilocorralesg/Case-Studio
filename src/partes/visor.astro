/* the real site opens live inside the detail. Not inside claude.ai, which does not let a page show other sites, and not on
   127.0.0.1, where the tools check the built page and must not load other sites. On localhost (npm run dev) it does */
const LIVE = !/claude|anthropic|^127\.0\.0\.1$/.test(location.hostname);

/* a tour is one tall image of n screens plus the first one again; it rests on each screen and glides to the next, like someone
   scrolling the site. Tours play only while they are on screen; a manual one (data-manual) plays when its owner says so */
/* the strip of a tour: its widths (srcset) and how wide it is drawn there (sizes), so each screen takes what it needs, 2x on a retina
   screen and never three times what it shows; it loads when it comes near, with its size known before it arrives */
const tourSrcset = (p, cel) => (cel ? `${p.celLo} 390w, ${p.cel} 585w, ${p.celHi} 780w` : `${p.tour} 800w, ${p.tourHi} 1600w`);
const tourHTML = (p, cls, attr, cel, sizes) => `<span class="tour${cls ? ' ' + cls : ''}" style="--f:${p.n + 1}" data-n="${p.n}"${attr ? ' ' + attr : ''}><img src="${cel ? p.cel : p.tour}" srcset="${tourSrcset(p, cel)}" sizes="${sizes || '100vw'}" width="${cel ? 585 : 800}" height="${(cel ? 1266 : 414) * (p.n + 1)}" alt="" loading="lazy" decoding="async" draggable="false"></span>`;
const Tours = (() => {
  const live = new Map();
  const io = 'IntersectionObserver' in window ? new IntersectionObserver((es) => es.forEach((e) => { const a = live.get(e.target); if (a) { if (e.isIntersecting) a.play(); else a.pause(); } }), { rootMargin: '12% 0px' }) : null;
  const start = (root) => {
    if (RM || !root) return () => {};
    const made = [];
    root.querySelectorAll('.tour').forEach((t, i) => {
      if (live.has(t)) return;
      const n = +t.dataset.n, img = t.firstElementChild, hold = 1900, move = 950, total = n * (hold + move), kf = [];
      for (let k = 0; k <= n; k++) {
        const tr = `translate3d(-50%,${(-k * 100 / (n + 1)).toFixed(4)}%,0)`;
        if (k < n) kf.push({ transform: tr, offset: k * (hold + move) / total }, { transform: tr, offset: (k * (hold + move) + hold) / total, easing: MOTION.ease('io') });
        else kf.push({ transform: tr, offset: 1 });
      }
      const a = img.animate(kf, { duration: total, iterations: Infinity, delay: -((i * 733) % total) });
      a.pause(); live.set(t, a); made.push(t);
      if (t.hasAttribute('data-manual')) return;
      if (io) io.observe(t); else a.play();
    });
    return () => made.forEach((t) => { const a = live.get(t); if (a) a.cancel(); live.delete(t); if (io) io.unobserve(t); });
  };
  return { start, get: (t) => live.get(t) };
})();
window.Tours = Tours;

/* the detail. Viewer.show(i, from, list, back): opens project i of the list (PROJECTS), grown out of the node "from"; when it closes,
   back(j) says which node takes back the project j the visitor ended on. Esc closes, the arrows go to the neighbours, Tab stays inside */
const Viewer = (() => {
  const el = document.querySelector('.xs'), $ = (s) => el.querySelector(s), root = document.documentElement;
  const view = $('.xs-view'), scroll = $('.xs-scroll'), strip = $('.xs-strip'), frame = $('.xs-live');
  const img = strip.appendChild(Object.assign(document.createElement('img'), { alt: '', decoding: 'async' }));
  const ticks = $('.xs-ticks'), note = $('.xs-note'), wide = $('.xs-wide'), more = $('.xs-more');
  const EXT = '<svg class="arr" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M5 11 11 5M6 5h5v5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>';
  /* the first sentence of the text: the story stays short and nothing is rewritten */
  const firstLine = (t) => (t.match(/^.*?\.(?=\s|$)/) || [t])[0];
  /* the live site's own scrollbar (white on Windows) goes just past the rounded edge, where it is cut. With a mouse it is at least
     12 px, for sites that draw a thin one of their own; on a phone scrollbars float over the page and nothing changes */
  const bar = (() => { const d = document.createElement('div'); d.style.cssText = 'position:absolute;top:-999px;width:100px;height:100px;overflow:scroll'; document.body.appendChild(d); const w = d.offsetWidth - d.clientWidth; d.remove(); return w; })();
  const over = FINE ? Math.max(bar, 12) : bar;
  if (over > 0) frame.style.width = `calc(100% + ${over}px)`;
  let list = [], cur = 0, open = false, src = null, back = null, last = null, anim = null, swap = 0, auto = 0, touched = false, slow = 0, want = '';
  const item = () => list[cur];
  const n = () => item().n;
  const screenH = () => strip.offsetHeight / n();
  const maxTop = () => Math.max(0, scroll.scrollHeight - scroll.clientHeight);
  const framed = () => LIVE && item().embed !== false;
  const mark = () => {
    const top = scroll.scrollTop, k = top >= maxTop() - 2 ? n() - 1 : Math.min(n() - 1, Math.round(top / Math.max(1, screenH())));
    ticks.querySelectorAll('.xs-tick').forEach((t, i) => { if (i === k) t.setAttribute('aria-current', 'true'); else t.removeAttribute('aria-current'); });
  };
  const stopAuto = () => { clearInterval(auto); auto = 0; };
  /* a tour walks by itself, one screen at a time, until it is touched */
  const startAuto = () => {
    stopAuto(); touched = false;
    if (RM || framed()) return;
    auto = setInterval(() => {
      if (touched || !open || scroll.scrollTop >= maxTop() - 2) { stopAuto(); return; }
      scroll.scrollTo({ top: Math.min((Math.round(scroll.scrollTop / screenH()) + 1) * screenH(), maxTop()), behavior: 'smooth' });
    }, 3400);
  };
  ['wheel', 'touchstart', 'pointerdown', 'keydown'].forEach((ev) => scroll.addEventListener(ev, () => { touched = true; stopAuto(); }, { passive: true }));
  scroll.addEventListener('scroll', () => requestAnimationFrame(mark), { passive: true });
  /* the live page fades in over the tour once it has loaded; a page that is left is unloaded, so it stops running */
  frame.addEventListener('load', () => {
    if (!open || !want || frame.getAttribute('src') !== want) return;
    clearTimeout(slow); view.classList.add('is-live'); note.hidden = true;
  });
  const unload = () => { want = ''; const s = frame.getAttribute('src'); if (s && s !== 'about:blank') frame.src = 'about:blank'; };
  const goLive = () => {
    view.classList.remove('is-live'); clearTimeout(slow);
    const p = item();
    if (!framed()) {
      unload(); view.classList.remove('is-framed');
      note.firstElementChild.textContent = p.embed === false
        ? `${p.name} no se deja abrir dentro de otra página. Este es su recorrido.`
        : 'En el sitio publicado aquí se abre el sitio en vivo. Este es su recorrido.';
      note.hidden = false; return;
    }
    view.classList.add('is-framed'); note.hidden = true;
    frame.title = `Sitio de ${p.name}`;
    want = p.url; frame.src = p.url;
    /* a site that takes too long keeps showing its tour, with the way out */
    slow = setTimeout(() => { if (!view.classList.contains('is-live')) { note.firstElementChild.textContent = `${p.name} está tardando en cargar. Mientras tanto, este es su recorrido.`; note.hidden = false; view.classList.remove('is-framed'); } }, 9000);
  };
  const sib = (b, x, label) => {
    b.innerHTML = `<img src="${x.img}" width="320" height="166" alt="" decoding="async"><span><small>${label}</small><b>${x.name}</b></span>`;
    b.setAttribute('aria-label', `${label}: ${x.name}`);
  };
  /* the strip: on a phone, the site as a phone sees it, when it has its phone tour */
  const PHONE = matchMedia('(max-width:900px)');
  /* the detail draws its strip as wide as its view: on a computer about three quarters of the screen, on a phone all of it */
  const setStrip = () => {
    const p = item(), cel = PHONE.matches && p.cel, src = cel ? p.celHi : p.tourHi;
    strip.style.aspectRatio = cel ? `585 / ${1266 * p.n}` : `800 / ${414 * p.n}`;
    strip.style.setProperty('--pf', cel ? 'none' : `url('${new URL(p.img, document.baseURI).href}')`);
    if (img.getAttribute('src') !== src) { img.sizes = cel ? '100vw' : '75vw'; img.srcset = tourSrcset(p, cel); img.src = src; }
  };
  PHONE.addEventListener('change', () => { if (!el.hidden) setStrip(); });
  const fill = () => {
    const p = item(), N = list.length;
    el.querySelectorAll('.xs-el').forEach((e) => { e.firstElementChild.textContent = zOf(p.sym); e.lastElementChild.textContent = p.sym; });
    $('.xs-out').href = p.url;
    $('#xs-name').textContent = p.name; $('.xs-kind').textContent = p.kind; $('.xs-lead').textContent = firstLine(p.lead);
    $('.xs-chips').innerHTML = p.facts.slice(0, 3).filter(Boolean).map((f) => `<li>${f}</li>`).join('');
    $('.xs-feats').innerHTML = p.feats.map((x) => `<li>${x}</li>`).join('');
    more.open = false;
    $('.xs-visits').innerHTML = `<a class="btn btn--white xs-visit" href="${p.url}" target="_blank" rel="noopener">Visitar sitio ${EXT}</a>`;
    sib($('.xs-prev'), list[(cur + N - 1) % N], 'Anterior'); sib($('.xs-next'), list[(cur + 1) % N], 'Siguiente');
    setStrip();
    scroll.setAttribute('aria-label', `Pantallas de ${p.name}`);
    ticks.innerHTML = Array.from({ length: p.n }, (_, i) => `<button class="xs-tick" type="button" aria-label="Pantalla ${i + 1} de ${p.n}">${i + 1}</button>`).join('');
    ticks.querySelectorAll('.xs-tick').forEach((t, i) => t.addEventListener('click', () => { touched = true; stopAuto(); scroll.scrollTo({ top: Math.min(i * screenH(), maxTop()), behavior: RM ? 'auto' : 'smooth' }); }));
  };
  /* the screen of the wheel is where this one starts: same place, same size, same screen of the site */
  const screenOf = (node) => {
    const t = node && node.querySelector('.tour'), im = t && t.firstElementChild;
    if (!im) return 0;
    const per = im.offsetHeight / (+t.dataset.n + 1), y = new DOMMatrixReadOnly(getComputedStyle(im).transform).m42;
    return per ? Math.round(-y / per) % +t.dataset.n : 0;
  };
  const radius = (node) => parseFloat(getComputedStyle(node).borderTopLeftRadius) || 16;
  /* the view at the size and place of the node it grows from: scaled down to cover it, and cut to its shape from the top left */
  const between = (A, r0, out) => {
    const B = view.getBoundingClientRect(), s = Math.max(A.width / B.width, A.height / B.height);
    const cx = Math.max(0, B.width - A.width / s), cy = Math.max(0, B.height - A.height / s), r = radius(view);
    const small = { transform: `translate(${(A.left - B.left).toFixed(1)}px,${(A.top - B.top).toFixed(1)}px) scale(${s.toFixed(4)})`, clipPath: `inset(0px ${cx.toFixed(1)}px ${cy.toFixed(1)}px 0px round ${(r0 / s).toFixed(1)}px)` };
    const big = { transform: 'none', clipPath: `inset(0px 0px 0px 0px round ${r}px)` };
    return view.animate(out ? [big, small] : [small, big], out ? { duration: MOTION.d('move'), easing: MOTION.ease('io'), fill: 'forwards' } : { duration: MOTION.d('enter'), easing: MOTION.ease('out') });
  };
  const tell = () => { el.classList.remove('is-told'); void el.offsetWidth; el.classList.add('is-told'); };
  const setWide = (on) => {
    el.classList.toggle('is-wide', on); wide.setAttribute('aria-pressed', String(on));
    wide.setAttribute('aria-label', on ? 'Ver el sitio con su historia' : 'Ver el sitio a todo el ancho');
  };
  /* the page keeps its width while the detail is open: the place of its scrollbar is held, so nothing behind moves */
  const lock = (on) => {
    if (on) root.style.setProperty('--xs-sbw', `${Math.max(0, innerWidth - root.clientWidth)}px`);
    root.classList.toggle('xs-on', on);
    /* the smooth scroll of the page rests too (suave.astro) */
    if (window.LENIS) { if (on) window.LENIS.stop(); else window.LENIS.start(); }
  };
  const show = (i, from, items, onBack) => {
    if (open) return false;
    list = items || PROJECTS; cur = i; src = from || null; back = onBack || null; last = document.activeElement; open = true;
    if (anim) { anim.cancel(); anim = null; }
    const A = !RM && src ? src.getBoundingClientRect() : null;
    setWide(false); fill();
    el.hidden = false; lock(true);
    scroll.scrollTop = screenOf(src) * screenH(); mark();
    if (A) { src.style.visibility = 'hidden'; anim = between(A, radius(src), false); }
    requestAnimationFrame(() => { el.classList.add('is-in'); tell(); });
    $('.xs-close').focus({ preventScroll: true });
    /* the live page starts loading as the screen grows */
    goLive(); startAuto();
    return true;
  };
  const close = () => {
    if (!open) return;
    open = false; stopAuto(); clearTimeout(swap); clearTimeout(slow); el.classList.remove('is-swap');
    const target = back ? back(cur) : src;
    if (src && src !== target) src.style.visibility = '';
    view.classList.remove('is-live');
    el.classList.remove('is-in', 'is-told');
    const finish = () => {
      el.hidden = true; lock(false);
      unload(); view.classList.remove('is-framed'); setWide(false);
      if (anim) { anim.cancel(); anim = null; }
      if (target) target.style.visibility = '';
      if (last && last.isConnected) last.focus({ preventScroll: true });
    };
    if (RM || !target || !target.isConnected) { finish(); return; }
    target.style.visibility = 'hidden';
    $('.xs-in').scrollTop = 0;
    scroll.scrollTop = Math.round(scroll.scrollTop / screenH()) * screenH();
    if (anim) anim.cancel();
    anim = between(target.getBoundingClientRect(), radius(target), true);
    anim.onfinish = finish;
  };
  /* to a neighbour without closing: the story and the site fade, change and come back */
  const go = (d) => {
    if (!open) return;
    el.classList.add('is-swap'); stopAuto(); clearTimeout(swap);
    swap = setTimeout(() => {
      cur = (cur + d + list.length) % list.length; fill(); scroll.scrollTop = 0; $('.xs-in').scrollTop = 0; $('.xs-panel-in').scrollTop = 0;
      mark();
      el.classList.remove('is-swap'); tell(); goLive(); startAuto();
    }, RM ? 0 : 150);
  };
  /* the link of the note always leads somewhere, also before the first project is opened */
  $('.xs-out').href = PROJECTS[0].url;
  $('.xs-close').addEventListener('click', close);
  $('.xs-prev').addEventListener('click', () => go(-1));
  $('.xs-next').addEventListener('click', () => go(1));
  wide.addEventListener('click', () => setWide(!el.classList.contains('is-wide')));
  /* while it is open the detail owns the keyboard: Esc closes, the arrows go to the neighbours, Tab stays inside */
  addEventListener('keydown', (e) => {
    if (!open) return;
    e.stopImmediatePropagation();
    if (e.key === 'Escape') { e.preventDefault(); close(); }
    else if (e.key === 'ArrowRight' && e.target !== scroll) go(1);
    else if (e.key === 'ArrowLeft' && e.target !== scroll) go(-1);
    else if (e.key === 'Tab') {
      const f = [...el.querySelectorAll('button,a[href],summary,iframe,[tabindex="0"]')].filter((x) => x.offsetParent !== null && getComputedStyle(x).visibility !== 'hidden'), a = document.activeElement, i = f.indexOf(a);
      if (e.shiftKey && i <= 0) { e.preventDefault(); f[f.length - 1].focus(); }
      else if (!e.shiftKey && i === f.length - 1) { e.preventDefault(); f[0].focus(); }
    }
  }, true);
  return { show, close };
})();
</script>
